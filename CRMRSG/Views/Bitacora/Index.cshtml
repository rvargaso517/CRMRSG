@model List<CRMRSG.EntityFramework.bitacora>
@{
    ViewBag.Title = "Bitácora del Sistema";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuarios = (List<CRMRSG.EntityFramework.usuario>)ViewBag.Usuarios;
    var selectedId = (int?)ViewBag.SelectedUsuarioId;
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;

    var chartLabels = (string[])ViewBag.ChartLabels;
    var chartData = (int[])ViewBag.ChartData;
}

<div class="content-header">
    <div class="d-flex align-items-center">
        <div class="me-auto">
            <h4 class="page-title">Historial de Acciones</h4>
            <div class="d-inline-block align-items-center">
                <nav>
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="~/Dashboard"><i class="mdi mdi-home-outline"></i></a></li>
                        <li class="breadcrumb-item active" aria-current="page">Auditoría de Bitácora</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Gráfico de Actividad por Usuario -->
    <div class="col-xl-4 col-12">
        <div class="box">
            <div class="box-header with-border">
                <h4 class="box-title">Actividad por Usuario (Top 5)</h4>
            </div>
            <div class="box-body">
                <div id="bitacora-user-chart"></div>
            </div>
        </div>
    </div>

    <!-- Filtro de la Bitácora -->
    <div class="col-xl-8 col-12">
        <div class="box">
            <div class="box-header with-border">
                <h4 class="box-title">Filtros de Búsqueda</h4>
            </div>
            <div class="box-body">
                @using (Html.BeginForm("Index", "Bitacora", FormMethod.Get, new { @class = "row align-items-end" }))
                {
                    <div class="col-md-8 col-12 form-group mb-0">
                        <label class="form-label">Filtrar por Usuario / Empleado</label>
                        <select name="usuarioId" class="form-select">
                            <option value="">-- Todos los Usuarios --</option>
                            @foreach (var user in usuarios)
                            {
                                <option value="@user.id_usuario" @(selectedId == user.id_usuario ? "selected" : "")>
                                    @user.nombre @user.apellido (@user.correo)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 col-12 text-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fa fa-filter me-2"></i> Filtrar
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="box">
            <div class="box-header with-border">
                <h3 class="box-title">Registro de Actividades del Sistema</h3>
            </div>
            <div class="box-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Fecha y Hora</th>
                                <th>Usuario</th>
                                <th>Acción</th>
                                <th>Módulo/Tabla</th>
                                <th>Detalle de Actividad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted p-20">
                                        No se encontraron registros en la bitácora.
                                    </td>
                                </tr>
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-nowrap">
                                        @(item.fecha_hora.HasValue
                                            ? item.fecha_hora.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                            : "N/A")
                                    </td>
                                    <td class="fw-bold">
                                        @(item.usuario != null
                                            ? item.usuario.nombre + " " + item.usuario.apellido
                                            : "Sistema/Anónimo")
                                    </td>
                                    <td>
                                        @if (item.accion == "Creación")
                                        {
                                            <span class="badge badge-success-light">Creación</span>
                                        }
                                        else if (item.accion == "Modificación")
                                        {
                                            <span class="badge badge-warning-light">Modificación</span>
                                        }
                                        else if (item.accion == "Eliminación")
                                        {
                                            <span class="badge badge-danger-light">Eliminación</span>
                                        }
                                        else if (item.accion == "Login" || item.accion == "Ingreso" || item.accion == "Logear")
                                        {
                                            <span class="badge badge-primary-light">Ingreso (Login)</span>
                                        }
                                        else if (item.accion == "Logout" || item.accion == "Salida" || item.accion == "Deslogear")
                                        {
                                            <span class="badge badge-secondary-light">Salida (Logout)</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-info-light">@item.accion</span>
                                        }
                                    </td>
                                    <td class="text-capitalize">@item.tabla_afectada</td>
                                    <td>
                                        @{
                                            string desc = "";
                                            string modulo = item.tabla_afectada ?? "";
                                            if (modulo == "clientes") { modulo = "Clientes"; }
                                            else if (modulo == "oportunidades") { modulo = "Oportunidades"; }
                                            else if (modulo == "tareas") { modulo = "Tareas"; }
                                            else if (modulo == "citas") { modulo = "Citas / Eventos"; }
                                            else if (modulo == "usuarios") { modulo = "Usuarios"; }
                                            else if (modulo == "contacto_cliente") { modulo = "Contactos"; }
                                            else if (modulo == "nota_cliente") { modulo = "Notas"; }
                                            else if (modulo == "auth" || modulo == "sesion") { modulo = "Sesión"; }

                                            if (item.accion == "Creación")
                                            {
                                                desc = $"Creó un nuevo registro en {modulo}.";
                                            }
                                            else if (item.accion == "Modificación")
                                            {
                                                desc = $"Modificó un registro existente en {modulo}.";
                                            }
                                            else if (item.accion == "Eliminación")
                                            {
                                                desc = $"Eliminó un registro de {modulo}.";
                                            }
                                            else if (item.accion == "Login" || item.accion == "Ingreso" || item.accion == "Logear")
                                            {
                                                desc = "El usuario inició sesión en el sistema.";
                                            }
                                            else if (item.accion == "Logout" || item.accion == "Salida" || item.accion == "Deslogear")
                                            {
                                                desc = "El usuario cerró sesión en el sistema.";
                                            }
                                            else
                                            {
                                                desc = $"{item.accion} en {modulo}.";
                                            }
                                        }
                                        @desc
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación por Pestañas (Máximo 10 por página) -->
                @if (totalPages > 1)
                {
                    <div class="p-20 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Mostrando página @currentPage de @totalPages</span>
                        <nav>
                            <ul class="pagination mb-0">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, usuarioId = selectedId })">Anterior</a>
                                </li>

                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(currentPage == i ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, usuarioId = selectedId })">@i</a>
                                    </li>
                                }

                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, usuarioId = selectedId })">Siguiente</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Content/assets/vendor_components/apexcharts-bundle/dist/apexcharts.js")"></script>
    <script>
        $(document).ready(function() {
            if ($('#bitacora-user-chart').length > 0) {
                var labels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(chartLabels));
                var data = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(chartData));

                if (labels.length === 0) {
                    labels = ['Sin datos'];
                    data = [0];
                }

                var options = {
                    series: data,
                    chart: { type: 'pie', height: 280, background: 'transparent', redrawOnWindowResize: true },
                    labels: labels,
                    colors: ['#1d3557', '#e63946', '#10c469', '#f4a261', '#188ae2'],
                    stroke: { colors: ['#ffffff'], width: 1 },
                    legend: {
                        position: 'bottom',
                        horizontalAlign: 'center',
                        floating: false,
                        itemMargin: { horizontal: 5, vertical: 5 }
                    },
                    responsive: [{
                        breakpoint: 480,
                        options: {
                            chart: { height: 320 },
                            legend: { position: 'bottom' }
                        }
                    }]
                };
                new ApexCharts(document.querySelector("#bitacora-user-chart"), options).render();
            }
        });
    </script>
}