@model List<CRMRSG.EntityFramework.bitacora>
@{
    ViewBag.Title = "Bitácora del Sistema";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuarios = (List<CRMRSG.EntityFramework.usuario>)ViewBag.Usuarios;
    var selectedId = (int?)ViewBag.SelectedUsuarioId;
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;

    var chartLabels = (string[])ViewBag.ChartLabels;
    var chartData = (int[])ViewBag.ChartData;
}

<div class="content-header">
    <div class="d-flex align-items-center">
        <div class="me-auto">
            <h4 class="page-title">Historial de Acciones</h4>
            <div class="d-inline-block align-items-center">
                <nav>
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="~/Dashboard"><i class="mdi mdi-home-outline"></i></a></li>
                        <li class="breadcrumb-item active" aria-current="page">Auditoría de Bitácora</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-4 col-12">
        <div class="box">
            <div class="box-header with-border">
                <h4 class="box-title">Actividad por Usuario (Top 5)</h4>
            </div>
            <div class="box-body">
                <div id="bitacora-user-chart"></div>
            </div>
        </div>
    </div>

    <div class="col-xl-8 col-12">
        <div class="box">
            <div class="box-header with-border">
                <h4 class="box-title">Filtros de Búsqueda</h4>
            </div>
            <div class="box-body">
                @using (Html.BeginForm("Index", "Bitacora", FormMethod.Get, new { @class = "row align-items-end" }))
                {
                    <div class="col-md-8 col-12 form-group mb-0">
                        <label class="form-label">Filtrar por Usuario / Empleado</label>
                        <select name="usuarioId" class="form-select">
                            <option value="">-- Todos los Usuarios --</option>
                            @foreach (var user in usuarios)
                            {
                                <option value="@user.id_usuario" @(selectedId == user.id_usuario ? "selected" : "")>
                                    @user.nombre @user.apellido (@user.correo)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4 col-12 text-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fa fa-filter me-2"></i> Filtrar
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="box">

            <div class="box-header with-border">
                <h3 class="box-title">Registro de Actividades del Sistema</h3>
            </div>

            <div class="box-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead class="bg-light">

                            <tr>
                                <th>Fecha y Hora</th>
                                <th>Usuario</th>
                                <th>Acción</th>
                                <th>Módulo/Tabla</th>
                                <th>Detalle de Actividad</th>
                            </tr>

                        </thead>

                        <tbody id="bitacora-tbody">

                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted p-20">
                                        No se encontraron registros en la bitácora.
                                    </td>
                                </tr>
                            }

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="text-nowrap">
                                        @(item.fecha_hora.HasValue
                                            ? item.fecha_hora.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                            : "N/A")
                                    </td>

                                    <td class="fw-bold">
                                        @(item.usuario != null
                                            ? item.usuario.nombre + " " + item.usuario.apellido
                                            : "Sistema/Anónimo")
                                    </td>

                                    <td>

                                        @if (item.accion == "Creación")
                                        {
                                            <span class="badge badge-success-light">
                                                Creación
                                            </span>
                                        }
                                        else if (item.accion == "Modificación")
                                        {
                                            <span class="badge badge-warning-light">
                                                Modificación
                                            </span>
                                        }
                                        else if (item.accion == "Eliminación")
                                        {
                                            <span class="badge badge-danger-light">
                                                Eliminación
                                            </span>
                                        }
                                        else if (item.accion == "Login" || item.accion == "Ingreso" || item.accion == "Logear")
                                        {
                                            <span class="badge badge-primary-light">Ingreso (Login)</span>
                                        }
                                        else if (item.accion == "Logout" || item.accion == "Salida" || item.accion == "Deslogear")
                                        {
                                            <span class="badge badge-secondary-light">Salida (Logout)</span>
                                        }
                                        else if (item.accion == "Envío Correo")
                                        {
                                            <span class="badge badge-success-light">Envío Correo</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-info-light">@item.accion</span>
                                        }
                                    </td>

                                    <td class="text-capitalize">
                                        @{
                                            string tblAfectada = item.tabla_afectada ?? "";
                                            if (tblAfectada.ToLower() == "citas") { tblAfectada = "Actividades"; }
                                            else if (tblAfectada.ToLower() == "contacto_cliente") { tblAfectada = "Contactos"; }
                                            else if (tblAfectada.ToLower() == "nota_cliente") { tblAfectada = "Notas"; }
                                        }
                                        @tblAfectada
                                    </td>

                                    <td>

                                        @{

                                            string desc = "";
                                            string modulo = item.tabla_afectada ?? "";
                                            if (modulo == "clientes") { modulo = "Clientes"; }
                                            else if (modulo == "oportunidades") { modulo = "Oportunidades"; }
                                            else if (modulo == "tareas") { modulo = "Tareas"; }
                                            else if (modulo == "citas") { modulo = "Actividades"; }
                                            else if (modulo == "usuarios") { modulo = "Usuarios"; }
                                            else if (modulo == "contacto_cliente") { modulo = "Contactos"; }
                                            else if (modulo == "nota_cliente") { modulo = "Notas"; }
                                            else if (modulo == "auth" || modulo == "sesion") { modulo = "Sesión"; }

                                            if (item.accion == "Creación")
                                            {
                                                desc = $"Creó un nuevo registro en {modulo}.";
                                                if (!string.IsNullOrEmpty(item.valor_nuevo))
                                                {
                                                    desc += $" ({item.valor_nuevo})";
                                                }
                                            }
                                            else if (item.accion == "Modificación")
                                            {
                                                string valN = item.valor_nuevo ?? "";
                                                string valA = item.valor_anterior ?? "";
                                                if (valN == "Completada")
                                                {
                                                    desc = $"Completó / Realizó una actividad de {modulo}.";
                                                }
                                                else if (valN == "Aplazada")
                                                {
                                                    desc = $"Aplazó / Pospuso una actividad de {modulo}.";
                                                }
                                                else if (valN == "Cancelada")
                                                {
                                                    desc = $"Canceló una actividad de {modulo}.";
                                                }
                                                else
                                                {
                                                    desc = $"Modificó un registro existente en {modulo}.";
                                                }

                                                if (!string.IsNullOrEmpty(valN) && valN != "Completada" && valN != "Aplazada" && valN != "Cancelada")
                                                {
                                                    desc += $" (De '{valA}' a '{valN}')";
                                                }
                                            }
                                            else if (item.accion == "Eliminación")
                                            {
                                                desc = $"Eliminó un registro de {modulo}.";
                                                if (!string.IsNullOrEmpty(item.valor_anterior))
                                                {
                                                    desc += $" ({item.valor_anterior})";
                                                }
                                            }
                                            else if (item.accion == "Login" || item.accion == "Ingreso" || item.accion == "Logear")
                                            {
                                                desc = "El usuario inició sesión en el sistema.";
                                            }
                                            else if (item.accion == "Logout" || item.accion == "Salida" || item.accion == "Deslogear")
                                            {
                                                desc = "El usuario cerró sesión en el sistema.";
                                            }
                                            else if (item.accion == "Envío Correo")
                                            {
                                                desc = $"Envió un correo electrónico desde el sistema. ({item.valor_nuevo})";
                                            }
                                            else
                                            {
                                                desc = $"{item.accion} en {modulo}.";
                                                if (!string.IsNullOrEmpty(item.valor_nuevo))
                                                {
                                                    desc += $" ({item.valor_nuevo})";
                                                }
                                            }
                                        }

                                        @desc

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <!-- Paginación por Pestañas (Máximo 10 por página) -->
                @if (totalPages > 1)
                {
                    <div class="p-20 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Mostrando página @currentPage de @totalPages</span>
                        <nav>
                            <ul class="pagination mb-0">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, usuarioId = selectedId })">Anterior</a>
                                </li>

                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(currentPage == i ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, usuarioId = selectedId })">@i</a>
                                    </li>
                                }

                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, usuarioId = selectedId })">Siguiente</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>

        </div>
    </div>
</div>


@section scripts {

    <script src="@Url.Content("~/Content/assets/vendor_components/apexcharts-bundle/dist/apexcharts.js")"></script>

    <script>

        var bitacoraPorPagina = 10;

        var paginaBitacoraActual = 1;


        $(document).ready(function() {

            if ($('#bitacora-user-chart').length > 0) {

                var labels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(chartLabels));

                var data = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(chartData));


                var chartPalette = localStorage.getItem('crm_chart_palette') || 'classic';
                var palettes = {
                    classic: {
                        line: ['#1d3557'],
                        donut: ['#2a9d8f', '#f4a261', '#e63946', '#1d3557', '#a8dadc', '#457b9d', '#e76f51', '#264653', '#e9c46a', '#f4a261', '#e76f51', '#9b5de5', '#f15bb5', '#00f5d4', '#00bbf9', '#fee440', '#3a86c8', '#8338ec', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#00f5d4', '#00bbf9', '#ff006e', '#f15bb5', '#9b5de5', '#2a9d8f', '#e63946'],
                        bar: ['#1d3557', '#e63946', '#457b9d', '#a8dadc', '#f4a261', '#e76f51', '#264653', '#e9c46a', '#f4a261', '#e76f51', '#9b5de5', '#f15bb5', '#00f5d4', '#00bbf9', '#fee440', '#3a86c8', '#8338ec', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#00f5d4', '#00bbf9', '#ff006e', '#f15bb5', '#9b5de5', '#2a9d8f', '#e63946']
                    },
                    ocean: {
                        line: ['#0077b6'],
                        donut: ['#0096c7', '#00b4d8', '#48cae4', '#90e0ef', '#03045e', '#023e8a', '#0077b6', '#0096c7', '#00b4d8', '#90e0ef', '#48cae4', '#00f5d4', '#00bbf9', '#3a86c8', '#8338ec', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200'],
                        bar: ['#03045e', '#023e8a', '#0077b6', '#0096c7', '#00b4d8', '#90e0ef', '#48cae4', '#00f5d4', '#00bbf9', '#3a86c8', '#8338ec', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#00f5d4', '#00bbf9', '#ff006e', '#f15bb5', '#9b5de5', '#2a9d8f', '#e63946']
                    },
                    neon: {
                        line: ['#7209b7'],
                        donut: ['#f72585', '#7209b7', '#3f37c9', '#4cc9f0', '#b5179e', '#480ca8', '#3a0ca3', '#3f37c9', '#4361ee', '#4cc9f0', '#7209b7', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200'],
                        bar: ['#f72585', '#b5179e', '#7209b7', '#480ca8', '#3f37c9', '#4361ee', '#4cc9f0', '#7209b7', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#00f5d4', '#00bbf9', '#ff006e', '#f15bb5', '#9b5de5', '#2a9d8f', '#e63946']
                    },
                    sunset: {
                        line: ['#d90429'],
                        donut: ['#d90429', '#f77f00', '#fcbf49', '#eae2b7', '#ef233c', '#ffb703', '#fb8500', '#d90429', '#ef233c', '#f77f00', '#fcbf49', '#eae2b7', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200'],
                        bar: ['#d90429', '#ef233c', '#f77f00', '#fcbf49', '#eae2b7', '#ffb703', '#fb8500', '#d90429', '#ef233c', '#f77f00', '#fcbf49', '#eae2b7', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#00f5d4', '#00bbf9', '#ff006e', '#f15bb5', '#9b5de5', '#2a9d8f', '#e63946']
                    },
                    forest: {
                        line: ['#2c6e49'],
                        donut: ['#2c6e49', '#4c956c', '#a3b18a', '#588157', '#1b4332', '#2d6a4f', '#40916c', '#52b788', '#74c69d', '#2c6e49', '#4c956c', '#a3b18a', '#588157', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200'],
                        bar: ['#1b4332', '#2d6a4f', '#40916c', '#52b788', '#74c69d', '#2c6e49', '#4c956c', '#a3b18a', '#588157', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#00f5d4', '#00bbf9', '#ff006e', '#f15bb5', '#9b5de5', '#2a9d8f', '#e63946']
                    }
                };

                var selectedColors = palettes[chartPalette] || palettes.classic;
                if (chartPalette === 'custom') {
                    var customColorsStr = localStorage.getItem('crm_custom_chart_colors');
                    var customColors = ['#2a9d8f', '#f4a261', '#e63946', '#1d3557', '#a8dadc', '#9b5de5', '#f15bb5', '#00f5d4', '#00bbf9', '#fee440', '#3a86c8', '#8338ec', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200'];
                    if (customColorsStr) {
                        try { customColors = JSON.parse(customColorsStr); } catch(e) {}
                    }
                    // Forzar que la paleta personalizada contenga suficientes colores para el grafico
                    if (customColors.length < 20) {
                        customColors = customColors.concat(['#3a86c8', '#8338ec', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#2a9d8f', '#f4a261', '#e63946']);
                    }
                    selectedColors = {
                        line: [customColors[0]],
                        donut: customColors,
                        bar: customColors
                    };
                }

                var boxBgColor = localStorage.getItem('crm_box_bg_color') || '#ffffff';
                var r = parseInt(boxBgColor.substr(1, 2), 16);
                var g = parseInt(boxBgColor.substr(3, 2), 16);
                var b = parseInt(boxBgColor.substr(5, 2), 16);
                var yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
                var chartThemeMode = (yiq < 128) ? 'dark' : 'light';
                var chartLabelColor = (yiq < 128) ? '#ffffff' : '#5a6a85';

                if (labels.length === 0) {
                    labels = ['Sin datos'];
                    data = [0];
                }

                var options = {

                    series: data,

                    chart: {
                        type: 'pie',
                        height: 280,
                        background: 'transparent',
                        redrawOnWindowResize: true
                    },

                    labels: labels,
                    colors: selectedColors.donut,
                    stroke: { colors: [boxBgColor], width: 1 },
                    dataLabels: {
                        enabled: false
                    },
                    legend: {
                        position: 'bottom',
                        horizontalAlign: 'center',
                        floating: false,
                        labels: { colors: chartLabelColor },
                        itemMargin: {
                            horizontal: 5,
                            vertical: 5
                        },
                        formatter: function(seriesName, opts) {
                            var total = opts.w.globals.series.reduce(function(acc, val) { return acc + val; }, 0);
                            var val = opts.w.globals.series[opts.seriesIndex];
                            var pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                            return seriesName + " - " + val + " (" + pct + "%)";
                        }
                    },

                    responsive: [{

                        breakpoint: 480,

                        options: {

                            chart: {
                                height: 320
                            },

                            legend: {
                                position: 'bottom'
                            }

                        }

                    }]

                };


                new ApexCharts(
                    document.querySelector("#bitacora-user-chart"),
                    options
                ).render();

            }


            paginarBitacora();

        });


        function paginarBitacora() {

            var filas =
                $("#bitacora-tbody tr");


            var totalRegistros =
                filas.length;


            if (
                totalRegistros === 1 &&
                filas.find("td").attr("colspan") === "5"
            ) {

                $("#bitacora-paginacion-container")
                    .hide();

                return;

            }


            var totalPaginas =
                Math.ceil(
                    totalRegistros /
                    bitacoraPorPagina
                );


            filas.hide();


            var inicio =
                (paginaBitacoraActual - 1) *
                bitacoraPorPagina;


            var fin =
                inicio +
                bitacoraPorPagina;


            filas
                .slice(inicio, fin)
                .show();


            if (totalPaginas <= 1) {

                $("#bitacora-paginacion-container")
                    .hide();

                return;

            }


            $("#bitacora-paginacion-container")
                .show();


            var html = `

                <nav aria-label="Paginación de bitácora">

                    <ul class="pagination pagination-sm mb-0">

                        <li class="page-item
                            ${paginaBitacoraActual === 1 ? 'disabled' : ''}">

                            <a class="page-link"
                               href="javascript:void(0)"
                               onclick="cambiarPaginaBitacora(${paginaBitacoraActual - 1})">

                                Anterior

                            </a>

                        </li>

            `;


            for (
                var i = 1;
                i <= totalPaginas;
                i++
            ) {

                html += `

                    <li class="page-item
                        ${i === paginaBitacoraActual ? 'active' : ''}">

                        <a class="page-link"
                           href="javascript:void(0)"
                           onclick="cambiarPaginaBitacora(${i})">

                            ${i}

                        </a>

                    </li>

                `;

            }


            html += `

                        <li class="page-item
                            ${paginaBitacoraActual === totalPaginas ? 'disabled' : ''}">

                            <a class="page-link"
                               href="javascript:void(0)"
                               onclick="cambiarPaginaBitacora(${paginaBitacoraActual + 1})">

                                Siguiente

                            </a>

                        </li>

                    </ul>

                </nav>

            `;


            $("#bitacora-paginacion")
                .html(html);


            $("#bitacora-info-paginacion").text(

                "Mostrando " +
                (inicio + 1) +
                " - " +
                Math.min(
                    fin,
                    totalRegistros
                ) +
                " de " +
                totalRegistros +
                " registros"

            );

        }


        function cambiarPaginaBitacora(pagina) {

            var totalRegistros =
                $("#bitacora-tbody tr").length;


            var totalPaginas =
                Math.ceil(
                    totalRegistros /
                    bitacoraPorPagina
                );


            if (
                pagina < 1 ||
                pagina > totalPaginas
            ) {

                return;

            }


            paginaBitacoraActual =
                pagina;


            paginarBitacora();

        }

    </script>
}