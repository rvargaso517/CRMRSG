    </div>

    <script src="@Url.Content("~/Content/js/vendors.min.js")"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jQuery-slimScroll/1.3.8/jquery.slimscroll.min.js"></script>
    <script src="@Url.Content("~/Content/js/pages/chat-popup.js")"></script>
    <script src="@Url.Content("~/Content/assets/icons/feather-icons/feather.min.js")"></script>
    <script src="@Url.Content("~/Content/js/demo.js")"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="@Url.Content("~/Content/js/template.js")"></script>
    <script>
        $(document).ready(function() {
            // Sincronizar Sidebar Skin con LocalStorage
            var initialSkin = localStorage.getItem('crm_sidebar_skin') || 'light';
            if (initialSkin === 'dark') {
                $('#toggle_left_sidebar_skin').prop('checked', true);
            }

            $('#toggle_left_sidebar_skin').on('change', function() {
                var skin = $(this).is(':checked') ? 'dark' : 'light';
                localStorage.setItem('crm_sidebar_skin', skin);
                if (skin === 'dark') {
                    localStorage.setItem('crm_bg_color', '#121212');
                    localStorage.setItem('crm_box_bg_color', '#1e1e1e');
                    localStorage.setItem('crm_sidebar_bg_color', '#181818');
                    localStorage.setItem('crm_header_bg_color', '#1e1e1e');
                } else {
                    localStorage.setItem('crm_bg_color', '#f4f6f9');
                    localStorage.setItem('crm_box_bg_color', '#ffffff');
                    localStorage.setItem('crm_sidebar_bg_color', '#ffffff');
                    localStorage.setItem('crm_header_bg_color', '#ffffff');
                }
                if (skin === 'dark') {
                    $('body').removeClass('light-skin').addClass('dark-skin');
                } else {
                    $('body').removeClass('dark-skin').addClass('light-skin');
                }
                location.reload();
            });

            // Manejador manual de dropdown para evitar conflictos de Bootstrap
            $('#notificationDropdown').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                $('#notification-li').toggleClass('show');
                $('#notification-menu').toggleClass('show');
            });

            $(document).on('click', function(e) {
                if (!$(e.target).closest('#notification-li').length) {
                    $('#notification-li').removeClass('show');
                    $('#notification-menu').removeClass('show');
                }
            });

            function cargarNotificacionesGlobales(mostrarPopups) {
                $.ajax({
                    url: '@Url.Action("ObtenerListaCompletas", "Notificaciones")',
                    type: 'GET',
                    dataType: 'json',
                    cache: false,
                    success: function(response) {
                        if (response.success && response.datos) {
                            var unreadNotifications = response.datos.filter(function(n) { return !n.leida; });
                            var unreadCount = unreadNotifications.length;
                            
                            // Actualizar badge
                            if (unreadCount > 0) {
                                $('#notification-badge').text(unreadCount).show();
                                $('#notification-count-text').text(unreadCount + ' Nuevas');
                            } else {
                                $('#notification-badge').hide();
                                $('#notification-count-text').text('0 Nuevas');
                            }

                            // Limpiar y llenar lista
                            var listContainer = $('#notification-list');
                            listContainer.find('.list-group-item').remove();

                            if (response.datos.length > 0) {
                                $('#no-notifications-msg').hide();
                                response.datos.forEach(function(noti) {
                                    var itemClass = noti.leida ? 'text-muted' : 'fw-bold bg-light';
                                    var itemHtml = `
                                        <a href="javascript:void(0);" class="list-group-item list-group-item-action ${itemClass} p-3 border-bottom rounded-0 position-relative" data-id="${noti.id_notificacion}" style="font-size: 0.85rem; display: block;">
                                            <div class="pe-4 text-dark">${noti.mensaje}</div>
                                            <div class="text-fade fs-10 mt-1"><i class="fa fa-clock-o me-1"></i>${noti.FechaRegistro}</div>
                                            ${!noti.leida ? '<span class="position-absolute top-50 end-0 translate-middle-y me-3 badge bg-primary rounded-circle" style="width: 8px; height: 8px; padding: 0;">&nbsp;</span>' : ''}
                                        </a>
                                    `;
                                    listContainer.append(itemHtml);
                                });
                            } else {
                                $('#no-notifications-msg').show();
                            }

                            // Mostrar alertas emergentes de SweetAlert2 para las no leídas (solo una vez por notificación)
                            if (mostrarPopups && unreadCount > 0) {
                                var shownIds = JSON.parse(sessionStorage.getItem('shown_notification_ids') || '[]');
                                var indexDelay = 0;
                                unreadNotifications.forEach(function(noti) {
                                    if (shownIds.indexOf(noti.id_notificacion) === -1) {
                                        shownIds.push(noti.id_notificacion);
                                        sessionStorage.setItem('shown_notification_ids', JSON.stringify(shownIds));
                                        setTimeout(function() {
                                            Swal.fire({
                                                title: '🔔 Alerta de CRM',
                                                text: noti.mensaje,
                                                icon: 'info',
                                                toast: true,
                                                position: 'top-end',
                                                showConfirmButton: false,
                                                showCloseButton: true,
                                                timer: 8000,
                                                timerProgressBar: true,
                                                didOpen: (toast) => {
                                                    toast.addEventListener('mouseenter', Swal.stopTimer);
                                                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                                                }
                                            }).then(() => {
                                                cargarNotificacionesGlobales(false);
                                            });
                                        }, indexDelay * 1200);
                                        indexDelay++;
                                    }
                                });
                            }
                        }
                    }
                });
            }

            // Cargar de inicio y mostrar popups
            cargarNotificacionesGlobales(true);

            // Marcar una como leída al hacer clic
            $(document).on('click', '#notification-list a.list-group-item', function() {
                var notiId = $(this).data('id');
                if (notiId) {
                    $.post('@Url.Action("MarcarComoLeida", "Notificaciones")', { id: notiId }, function(res) {
                        if (res.success) {
                            cargarNotificacionesGlobales(false);
                        }
                    });
                }
            });

            // Marcar todas como leídas
            $('#mark-all-read').on('click', function(e) {
                e.preventDefault();
                $.post('@Url.Action("MarcarTodasComoLeidas", "Notificaciones")', function(res) {
                    if (res.success) {
                        cargarNotificacionesGlobales(false);
                    }
                });
            });

            // Aggressive text node cleaner for the entire sidebar menu to remove dots, dashes, and underscores
            $('.sidebar-menu, .sidebar-menu *').contents().each(function() {
                if (this.nodeType === 3) { // Text node
                    var val = this.nodeValue;
                    if (/[._-]/.test(val)) {
                        // 1. Remove leading/trailing spaces, dots, dashes, or underscores
                        var cleaned = val.replace(/^[ ._-]+|[ ._-]+$/g, '');
                        // 2. Replace middle underscores or dashes with spaces
                        cleaned = cleaned.replace(/[_-]+/g, ' ');
                        this.nodeValue = cleaned;
                    }
                }
            });

            // Dynamic Save/Submit Button Activator (UX Enhancement)
            $('form').each(function() {
                var $form = $(this);
                // Skip the top search form and authentication login/register forms
                if ($form.attr('action') && ($form.attr('action').includes('Login') || $form.attr('action').includes('Registro') || $form.attr('action').includes('Clientes') && $form.attr('method') === 'get')) {
                    return;
                }
                
                var $submitBtn = $form.find('button[type="submit"], input[type="submit"]');
                if ($submitBtn.length === 0) return;
                
                // Set initial inactive state
                $submitBtn.css({
                    'opacity': '0.55',
                    'pointer-events': 'none',
                    'transition': 'all 0.2s ease-in-out'
                });
                
                // Enable button on any input or change event in the form
                $form.on('input change keyup', 'input, select, textarea', function() {
                    $submitBtn.css({
                        'opacity': '1',
                        'pointer-events': 'auto'
                    });
                });
            });
        });
    </script>
    @RenderSection("scripts", required: false)

    <!-- Static Override Stylesheet to force clean sidebar layout and typography -->
    <style>
        /* Force Segoe UI font using high-specificity selectors to guarantee override of the broken theme font */
        .sidebar-menu li a, 
        .sidebar-menu li a span,
        .sidebar-menu li.treeview > a,
        .sidebar-menu li.treeview > a > span,
        .sidebar-menu .treeview-menu li a,
        .sidebar-menu .treeview-menu li a span,
        .sidebar-menu *:not(.fa):not([class^="fa-"]):not([class*=" fa-"]) {
            font-family: Arial, Helvetica, sans-serif !important;
        }
        /* Add breathable vertical spacing between sidebar menu items */
        .sidebar-menu > li {
            margin-bottom: 12px !important;
        }
        .sidebar-menu li a i, 
        .sidebar-menu li a svg {
            margin-right: 8px !important;
        }
        /* Eliminate browser list bullets / markers / pseudo-elements in the sidebar menu */
        .sidebar-menu, .sidebar-menu li, .sidebar-menu ul, .sidebar-menu ul li, .treeview-menu, .treeview-menu li {
            list-style: none !important;
            list-style-type: none !important;
        }
        .sidebar-menu *::marker,
        .sidebar-menu li::marker,
        .sidebar-menu li a::marker {
            display: none !important;
            content: "" !important;
        }
        /* Highly explicit specific selector list to completely hide any pseudo-element bullets */
        .sidebar-menu li::before,
        .sidebar-menu li::after,
        .sidebar-menu li a::before,
        .sidebar-menu li a::after,
        .sidebar-menu li a span::before,
        .sidebar-menu li a span::after,
        .sidebar-menu li.treeview > a::before,
        .sidebar-menu li.treeview > a::after,
        .sidebar-menu li.treeview > a > span::before,
        .sidebar-menu li.treeview > a > span::after,
        .sidebar-menu .treeview-menu li a::before,
        .sidebar-menu .treeview-menu li a::after,
        .sidebar-menu .treeview-menu li a span::before,
        .sidebar-menu .treeview-menu li a span::after,
        .main-sidebar .sidebar-menu li a::before,
        .main-sidebar .sidebar-menu li a::after,
        .main-sidebar .sidebar-menu li a span::before,
        .main-sidebar .sidebar-menu li a span::after,
        .sidebar-menu svg::before,
        .sidebar-menu svg::after,
        .sidebar-menu li a svg::before,
        .sidebar-menu li a svg::after,
        .sidebar-menu *:not(.fa-angle-left):not(.fa-angle-right)::before, 
        .sidebar-menu *:not(.fa-angle-left):not(.fa-angle-right)::after {
            display: none !important;
            content: "" !important;
            opacity: 0 !important;
            visibility: hidden !important;
            width: 0 !important;
            height: 0 !important;
        }
        /* Eliminate any background images on any sidebar elements to prevent bullet image rendering */
        .sidebar-menu, .sidebar-menu * {
            background-image: none !important;
            text-decoration: none !important;
            text-decoration-line: none !important;
        }
        /* Force header on top of the sidebar to prevent sidebar container from covering the logo box */
        .main-header {
            z-index: 1050 !important;
        }
        /* Let inline styles on the new simplified logo structure handle it completely */
        .logo-box, .logo-box * {
            border: none !important;
        }
    </style>
</body>
</html>