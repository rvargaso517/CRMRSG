<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="@Url.Content("~/Content/bootstrap.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/css/vendors_css.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/css/style.css")?v=@DateTime.Now.Ticks">
    <link rel="stylesheet" href="@Url.Content("~/Content/css/skin_color.css")?v=@DateTime.Now.Ticks">
    <link rel="stylesheet" href="@Url.Content("~/Content/css/custom.css")?v=@DateTime.Now.Ticks">
    @Scripts.Render("~/bundles/modernizr")
    <script>
        (function() {
            var sidebarSkin = localStorage.getItem('crm_sidebar_skin') || 'light';
            var savedColor = localStorage.getItem('crm_theme_color');
            var savedBg = localStorage.getItem('crm_bg_color');
            var savedSidebarBg = localStorage.getItem('crm_sidebar_bg_color');
            var savedHeaderBg = localStorage.getItem('crm_header_bg_color');
            var savedBoxBg = localStorage.getItem('crm_box_bg_color');
            
            if (sidebarSkin === 'dark') {
                savedBg = '#121212';
                savedBoxBg = '#1e1e1e';
                savedSidebarBg = '#181818';
                savedHeaderBg = '#1e1e1e';
            }
            
            var cssText = '';
            
            if (savedColor) {
                var textCol = '#fff';
                if (savedColor.startsWith('#') && savedColor.length === 7) {
                    var r = parseInt(savedColor.substr(1, 2), 16);
                    var g = parseInt(savedColor.substr(3, 2), 16);
                    var b = parseInt(savedColor.substr(5, 2), 16);
                    var yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
                    textCol = (yiq >= 170) ? '#111111' : '#ffffff';
                }
                cssText += `
                    :root {
                        --theme-primary-custom: ` + savedColor + ` !important;
                    }
                    .btn-primary, .bg-primary, .btn-primary-light:hover {
                        background-color: ` + savedColor + ` !important;
                        border-color: ` + savedColor + ` !important;
                        color: ` + textCol + ` !important;
                    }
                    .btn-primary *, .btn-primary i, .btn-primary span {
                        color: ` + textCol + ` !important;
                    }
                    .text-primary, .sidebar-menu > li.active > a, .sidebar-menu > li:hover > a {
                        color: ` + savedColor + ` !important;
                    }
                    .badge-primary-light {
                        background-color: ` + savedColor + `20 !important;
                        color: ` + savedColor + ` !important;
                    }
                `;
            }
            if (savedBg) {
                var rBg = parseInt(savedBg.substr(1, 2), 16);
                var gBg = parseInt(savedBg.substr(3, 2), 16);
                var bBg = parseInt(savedBg.substr(5, 2), 16);
                var yiqBg = ((rBg * 299) + (gBg * 587) + (bBg * 114)) / 1000;
                var textContrastColor = (yiqBg >= 128) ? '#1a1a2e' : '#ffffff';
                var textMutedContrast = (yiqBg >= 128) ? '#5a6a85' : '#a8dadc';

                cssText += `
                    .content-wrapper, .wrapper {
                        background-color: ` + savedBg + ` !important;
                    }
                    /* Adaptar texto general en la página de perfil/cuenta */
                    .tab-pane, label.form-label, .box-title, h5, .nav-tabs .nav-link, .nav-tabs .nav-link.active {
                        color: ` + textContrastColor + ` !important;
                    }
                    p.text-muted, .text-fade, .small, .text-muted {
                        color: ` + textMutedContrast + ` !important;
                    }
                `;
            }
            if (savedSidebarBg) {
                var r = parseInt(savedSidebarBg.substr(1, 2), 16);
                var g = parseInt(savedSidebarBg.substr(3, 2), 16);
                var b = parseInt(savedSidebarBg.substr(5, 2), 16);
                var yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
                var contrastColor = (yiq >= 128) ? '#1a1a2e' : '#ffffff';
                
                cssText += `
                    .main-sidebar, .left-side, .logo-box {
                        background-color: ` + savedSidebarBg + ` !important;
                    }
                    .main-sidebar .sidebar-menu li a, 
                    .main-sidebar .sidebar-menu li a i, 
                    .main-sidebar .sidebar-menu li.treeview > a i,
                    .main-sidebar .sidebar-menu > li > a {
                        color: ` + contrastColor + ` !important;
                    }
                `;
            }
            if (savedHeaderBg) {
                var r = parseInt(savedHeaderBg.substr(1, 2), 16);
                var g = parseInt(savedHeaderBg.substr(3, 2), 16);
                var b = parseInt(savedHeaderBg.substr(5, 2), 16);
                var yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
                var contrastHeaderColor = (yiq >= 128) ? '#1a1a2e' : '#ffffff';
                
                cssText += `
                    .main-header, .main-header .navbar, .main-header .logo-box {
                        background-color: ` + savedHeaderBg + ` !important;
                    }
                    .main-header .navbar .nav > li > a,
                    .main-header .navbar .nav > li > a i,
                    .main-header .navbar .nav > li > a span,
                    .main-header .navbar .push-btn {
                        color: ` + contrastHeaderColor + ` !important;
                    }
                `;
            }
            if (savedBoxBg) {
                var r = parseInt(savedBoxBg.substr(1, 2), 16);
                var g = parseInt(savedBoxBg.substr(3, 2), 16);
                var b = parseInt(savedBoxBg.substr(5, 2), 16);
                var yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
                var contrastBoxColor = (yiq >= 128) ? '#1a1a2e' : '#ffffff';
                var contrastBoxMuted = (yiq >= 128) ? '#5a6a85' : '#a8dadc';
                
                cssText += `
                    .box, .card, .bg-white, .box-body, .box-header, .box-footer, .metric-card, 
                    .list-group-item, .media, .timeline-event, .fc-theme-standard td, .fc-theme-standard th, 
                    .fc, .fc-daygrid-day, .fc-col-header-cell, .fc-scrollgrid, .fc-list-event, 
                    .fc-timegrid-slot, .fc-timegrid-col, .fc-list-day, .table, .table td, .table th,
                    #clientes-table, #tareas-table, #oportunidades-table, #clientes-table td, #tareas-table td, #oportunidades-table td {
                        background-color: ` + savedBoxBg + ` !important;
                        color: ` + contrastBoxColor + ` !important;
                    }
                    .box-title, .card-title, h1, h2, h3, h4, h5, h6, .text-dark, td, th, 
                    .metric-card .value, .timeline-title, .fc-event-title, .fc-col-header-cell-cushion, 
                    .fc-daygrid-day-number, .fc-list-event-title, .list-group-item h6, .list-group-item p,
                    .list-group-item .text-dark, .list-group-item strong, .box-header .box-title {
                        color: ` + contrastBoxColor + ` !important;
                    }
                    .box p, .card p, .text-fade, .text-muted, .small, .metric-card .label, 
                    .timeline-time, .fc-event-time, .list-group-item small, .list-group-item .text-fade {
                        color: ` + contrastBoxMuted + ` !important;
                    }
                    .btn {
                        border-radius: 6px !important;
                        font-weight: 500 !important;
                        letter-spacing: 0.2px !important;
                    }
                    .table-responsive {
                        width: 100% !important;
                    }
                `;
            }
            
            // Global Layout optimizations, fonts unification and logo visibility
            cssText += `
                body, p, h1, h2, h3, h4, h5, h6, td, th, input, select, textarea, button, label {
                    font-family: 'Outfit', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
                }
                /* Eliminate browser list bullets / markers in the sidebar menu */
                .sidebar-menu, .sidebar-menu li, .sidebar-menu ul, .sidebar-menu ul li, .treeview-menu, .treeview-menu li {
                    list-style: none !important;
                    list-style-type: none !important;
                }
                .sidebar-menu li a::before, 
                .sidebar-menu li a::after, 
                .sidebar-menu li a span::before, 
                .sidebar-menu li a span::after {
                    display: none !important;
                    content: "" !important;
                }
                /* Force safe Segoe UI font on sidebar text & anchors to prevent spaces from rendering as dots/dashes */
                .sidebar-menu li a, 
                .sidebar-menu li a span {
                    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
                }
                .sidebar-menu li a i, 
                .sidebar-menu li a svg {
                    margin-right: 8px !important;
                }
                .content-wrapper {
                    min-height: calc(100vh - 60px) !important;
                }
                #clientes-box, #oportunidades-box, #tareas-box, #actividades-box, #redactor-box,
                #roles-box, #usuarios-box, #bitacora-box, #notificaciones-box {
                    min-height: 70vh !important;
                }
                /* Ensure logo is always correctly displayed in the sidebar header */
                .logo-box .logo-mini span:last-child, .logo-box .logo-lg span:last-child {
                    display: none !important;
                }
                .logo-box .logo-mini span:first-child, .logo-box .logo-lg span:first-child {
                    display: inline-block !important;
                }
                .logo-box img {
                    display: block !important;
                    max-height: 45px !important;
                }
            `;

            if (cssText) {
                var styleEl = document.createElement('style');
                styleEl.id = 'custom-theme-styles-runtime';
                styleEl.innerHTML = cssText;
                document.head.appendChild(styleEl);
            }
        })();
    </script>
</head>

<body class="hold-transition light-skin sidebar-mini theme-primary fixed @ViewBag.BodyClass">
    <script>
        (function() {
            var savedSkin = localStorage.getItem('crm_sidebar_skin');
            if (savedSkin === 'dark') {
                document.body.classList.remove('light-skin');
                document.body.classList.add('dark-skin');
            }
        })();
    </script>
    <div class="wrapper">
        <div id="loader"></div>

        <header class="main-header">
            <div class="d-flex align-items-center logo-box justify-content-start">
                <a href="@Url.Action("Index", "Dashboard")" class="logo" style="display: block !important; width: 100% !important; height: 100% !important; line-height: 60px !important; padding: 0 15px !important; opacity: 1 !important; visibility: visible !important; text-decoration: none !important;">
                    <img src="@Url.Content("~/Content/images/logo/rsg_logo.jpg")" alt="RSG Logo" style="max-height: 45px !important; width: auto !important; display: inline-block !important; vertical-align: middle !important; visibility: visible !important; opacity: 1 !important; border: none !important; filter: invert(1) !important; mix-blend-mode: screen !important;">
                </a>
            </div>

            <nav class="navbar navbar-static-top">

                <div class="app-menu d-flex align-items-center">
                    <ul class="header-megamenu nav">
                        <li class="btn-group nav-item">
                            <button class="btn btn-primary-light d-inline d-xl-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas" aria-controls="sidebarOffcanvas" aria-label="Toggle navigation">
                                <i data-feather="menu"></i>
                            </button>
                            <a href="#" class="waves-effect waves-light nav-link push-btn btn-primary-light d-none d-xl-inline" data-toggle="push-menu" role="button">
                                <i data-feather="menu"></i>
                            </a>
                        </li>
                    </ul>

                    <div class="search-bx mx-3 d-none d-md-block">
                        <form action="@Url.Content("~/Clientes")" method="get">
                            <div class="input-group flex-nowrap align-items-center" style="background-color: #f0f4f9; border-radius: 8px;">
                                <input type="text" name="search" class="form-control border-0 bg-transparent shadow-none" placeholder="Buscar clientes..." style="width: 200px;" value="@(ViewBag.SearchQuery ?? "")">
                                <button type="submit" class="bg-transparent border-0 text-muted px-2" style="border: none; cursor: pointer;"><i data-feather="search" style="width: 18px; height: 18px;"></i></button>
                            </div>
                        </form>
                    </div>

                </div>

                <div class="navbar-custom-menu r-side">
                    <ul class="nav navbar-nav" style="display: flex; flex-direction: row; align-items: center;">
                        <li class="dropdown notifications-menu btn-group">
                            <label class="switch mb-0">
                                <a class="waves-effect waves-light btn-primary-light svg-bt-icon">
                                    <input type="checkbox" data-mainsidebarskin="toggle" id="toggle_left_sidebar_skin">
                                    <span class="switch-on"><i data-feather="moon"></i></span>
                                    <span class="switch-off"><i data-feather="sun"></i></span>
                                </a>
                            </label>
                        </li>

                        <li class="dropdown user user-menu btn-group ms-2 me-2">
                            <a href="#" class="waves-effect waves-light dropdown-toggle w-auto bg-transparent p-0 no-shadow" title="Usuario" data-bs-toggle="modal" data-bs-target="#quick_user_toggle">
                                <div class="bg-primary-light rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; overflow: hidden;">
                                    <i data-feather="user" class="text-primary"></i>
                                </div>
                            </a>
                        </li>

                        <li class="dropdown btn-group nav-item" id="notification-li">
                            <a href="#" class="waves-effect waves-light nav-link btn-primary-light svg-bt-icon position-relative" data-bs-toggle="dropdown" aria-expanded="false" title="Notificaciones" id="notificationDropdown">
                                <i data-feather="bell"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notification-badge" style="display: none; font-size: 11px; padding: 3px 6px; font-weight: bold; color: white !important; background-color: #ff4f5a !important; line-height: 1; border-radius: 10px; z-index: 99;">0</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end p-0 m-0 shadow-lg border-0 rounded" aria-labelledby="notificationDropdown" id="notification-menu" style="width: 320px; max-height: 420px; overflow: hidden;">
                                <li class="bg-primary p-3 rounded-top d-flex justify-content-between align-items-center">
                                    <h6 class="text-white mb-0 fw-bold"><i class="fa fa-bell me-2"></i>Notificaciones</h6>
                                    <span class="badge bg-white text-primary" id="notification-count-text">0 Nuevas</span>
                                </li>
                                <li>
                                    <div class="list-group list-group-flush" id="notification-list" style="max-height: 300px; overflow-y: auto;">
                                        <div class="text-center p-4 text-muted text-fade" id="no-notifications-msg">
                                            <i data-feather="check-circle" class="mb-2" style="width: 30px; height: 30px; stroke-width: 1.5;"></i>
                                            <p class="mb-0 small">No tienes notificaciones pendientes</p>
                                        </div>
                                    </div>
                                </li>
                                <li class="bg-light text-center p-2 rounded-bottom border-top">
                                    <a href="javascript:void(0);" class="text-primary small fw-semibold" id="mark-all-read">Marcar todas como leídas</a>
                                </li>
                            </ul>
                    </ul>
                </div>
            </nav>
        </header>

        <aside class="main-sidebar d-none d-xl-block">
            <section class="sidebar position-relative">
                <div class="multinav">
                    <div class="multinav-scroll">
                        @{
                            bool esAdmin = Session["RolId"] != null && (int)Session["RolId"] == 1;
                            string perms = Session["Permisos"] != null ? Session["Permisos"].ToString() : "";
                            var permList = perms.Split(',');

                            bool puedeVerClientes = esAdmin || permList.Contains("Clientes:Ver") || permList.Contains("Admin:Acceso");
                            bool puedeVerOportunidades = esAdmin || permList.Contains("Oportunidades:Ver") || permList.Contains("Admin:Acceso");
                            bool puedeVerTareas = esAdmin || permList.Contains("Tareas:Ver") || permList.Contains("Admin:Acceso");
                            bool puedeVerActividades = esAdmin || permList.Contains("Actividades:Ver") || permList.Contains("Admin:Acceso");
                        }
                        <ul class="sidebar-menu" data-widget="tree">
                            <li><a href="@Url.Action("Index", "Dashboard")"><i data-feather="home"></i><span>Dashboard</span></a></li>
                            <li><a href="@Url.Action("Calendar", "Dashboard")"><i data-feather="calendar"></i><span>Calendario</span></a></li>
                            <li><a href="@Url.Action("RedactorCorreos", "Dashboard")"><i data-feather="mail"></i><span>Redactor de Correos</span></a></li>

                            @if (puedeVerClientes)
                            {
                                <li class="treeview">
                                    <a href="#">
                                        <i data-feather="users"></i>
                                        <span>Clientes</span>
                                        <span class="pull-right-container">
                                            <i class="fa fa-angle-right pull-right"></i>
                                        </span>
                                    </a>
                                    <ul class="treeview-menu">
                                        <li><a href="@Url.Action("Index", "Clientes")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Todos los Clientes</a></li>
                                        <li><a href="@Url.Action("Crear", "Clientes")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Nuevo Cliente</a></li>
                                    </ul>
                                </li>
                            }

                            @if (puedeVerOportunidades)
                            {
                                <li class="treeview">
                                    <a href="#">
                                        <i data-feather="briefcase"></i>
                                        <span>Oportunidades</span>
                                        <span class="pull-right-container">
                                            <i class="fa fa-angle-right pull-right"></i>
                                        </span>
                                    </a>
                                    <ul class="treeview-menu">
                                        <li><a href="@Url.Action("Index", "Oportunidades")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Todas las Oportunidades</a></li>
                                        <li><a href="@Url.Action("Crear", "Oportunidades")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Nueva Oportunidad</a></li>
                                        <li><a href="@Url.Action("Kanban", "Oportunidades")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Tablero Kanban</a></li>
                                    </ul>
                                </li>
                            }

                            @if (puedeVerTareas)
                            {
                                <li class="treeview">
                                    <a href="#">
                                        <i data-feather="check-circle"></i>
                                        <span>Tareas</span>
                                        <span class="pull-right-container">
                                            <i class="fa fa-angle-right pull-right"></i>
                                        </span>
                                    </a>
                                    <ul class="treeview-menu">
                                        <li><a href="@Url.Action("Index", "Tareas")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Mis Tareas</a></li>
                                        <li><a href="@Url.Action("Crear", "Tareas")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Nueva Tarea</a></li>
                                    </ul>
                                </li>
                            }

                            @if (puedeVerActividades)
                            {
                                <li class="treeview">
                                    <a href="#">
                                        <i data-feather="activity"></i>
                                        <span>Actividades</span>
                                        <span class="pull-right-container">
                                            <i class="fa fa-angle-right pull-right"></i>
                                        </span>
                                    </a>
                                    <ul class="treeview-menu">
                                        <li><a href="@Url.Action("Index", "Actividades")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Todas las Actividades</a></li>
                                        <li><a href="@Url.Action("Crear", "Actividades")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Nueva Actividad</a></li>
                                    </ul>
                                </li>
                            }

                            <li class="treeview">
                                <a href="#">
                                    <i data-feather="bell"></i>
                                    <span>Notificaciones</span>
                                    <span class="pull-right-container">
                                        <i class="fa fa-angle-right pull-right"></i>
                                    </span>
                                </a>
                                <ul class="treeview-menu">
                                    <li><a href="@Url.Action("Index", "Notificaciones")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Todas las Notificaciones</a></li>
                                </ul>
                            </li>

                           

                            @if (Session["RolId"] != null && (int)Session["RolId"] == 1)
                            {
                                <li class="treeview">
                                    <a href="#">
                                        <i data-feather="shield"></i>
                                        <span>Administración</span>
                                        <span class="pull-right-container">
                                            <i class="fa fa-angle-right pull-right"></i>
                                        </span>
                                    </a>
                                    <ul class="treeview-menu">
                                        <li><a href="@Url.Action("Index", "Usuarios")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Gestión de Usuarios</a></li>
                                        <li><a href="@Url.Action("Index", "Roles")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Gestión de Roles</a></li>
                                        <li><a href="@Url.Action("Index", "Bitacora")"><i class="icon-Commit"><span class="path1"></span><span class="path2"></span></i>Bitácora y Auditoría</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>


                    </div>
                </div>
            </section>
        </aside>

        <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas" aria-labelledby="sidebarOffcanvasLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="sidebarOffcanvasLabel">Menú</h5>
                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-0">
                <nav class="p-3">
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Dashboard")">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Calendar", "Dashboard")">Calendario</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Clientes")">Clientes</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Oportunidades")">Oportunidades</a></li>
                    </ul>
                </nav>
            </div>
        </div>

        <div class="content-wrapper">
            <div class="container-fluid" style="width: 100% !important; max-width: 100% !important;">
                <section class="content" style="width: 100% !important; max-width: 100% !important;">
                    @RenderBody()
                </section>
            </div>
        </div>

        <footer class="main-footer bt-1">
            <div class="pull-right d-none d-sm-inline-block">
                <ul class="nav nav-primary nav-dotted nav-dot-separated justify-content-center justify-content-md-end">
                    <li class="nav-item">
                        <a class="nav-link" href="#" target="_blank">Sistema CRM</a>
                    </li>
                </ul>
            </div>
            &copy;
            <script>document.write(new Date().getFullYear())</script> CRM Management System. All Rights Reserved.
        </footer>

        <div class="modal modal-right fade" id="quick_user_toggle" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content slim-scroll3">
                    <div class="modal-body p-30 bg-white">
                        <div class="d-flex align-items-center mb-15 justify-content-between pb-30">
                            <h4 class="m-0">Perfil de Usuario</h4>
                            <a href="#" class="btn btn-icon btn-danger-light btn-sm no-shadow" data-bs-dismiss="modal">
                                <span class="fa fa-close"></span>
                            </a>
                        </div>
                        <div>
                            <div class="d-flex flex-row align-items-center">
                                <div>
                                    <div class="bg-primary-light rounded d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                        <i data-feather="user" class="text-primary fs-30"></i>
                                    </div>
                                </div>
                                <div class="ps-3">
