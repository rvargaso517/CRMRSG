@model IEnumerable<CRMRSG.EntityFramework.cliente>
@{
    ViewBag.Title = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="d-flex align-items-center">
        <div class="me-auto">
            <h4 class="page-title">Gestión de Clientes</h4>
            <div class="d-inline-block align-items-center">
                <nav>
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="~/Dashboard"><i class="mdi mdi-home-outline"></i></a></li>
                        <li class="breadcrumb-item active" aria-current="page">Listado de Clientes</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="box" id="clientes-box">
            <div class="box-header with-border d-flex justify-content-between align-items-center flex-wrap gap-3">
                <h3 class="box-title">Listado de Clientes Inteligente</h3>
                
                <!-- Filtros rápidos por clasificación -->
                <div class="btn-group" role="group" id="btn-group-filter">
                    <button type="button" class="btn btn-sm btn-outline-primary active" data-filter="all">Todos</button>
                    <button type="button" class="btn btn-sm btn-outline-success" data-filter="VIP">👑 VIP (Score >= 70)</button>
                    <button type="button" class="btn btn-sm btn-outline-warning" data-filter="Medio">🤝 Medio (35-69)</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="Bajo">❄️ Bajo (< 35)</button>
                </div>

                <div class="d-flex gap-2">

                    <a href="@Url.Action("Index","ImportacionClientes")"
                       class="btn btn-success btn-sm">
                        <i class="fa fa-upload"></i> Importar Clientes
                    </a>

                    <a href="~/Clientes/ReasignacionMasiva"
                       class="btn btn-warning btn-sm text-dark">
                        <i class="fa fa-exchange"></i> Reasignación Masiva
                    </a>

                    <a href="~/Clientes/Crear"
                       class="btn btn-primary btn-sm">
                        <i class="fa fa-plus"></i> Nuevo Cliente
                    </a>

                </div>
            </div>
            <div class="box-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="clientes-table">
                        <thead>
                            <tr>
                                <th>Empresa</th>
                                <th>Contacto Principal</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th class="w-150">Lead Scoring</th>
                                <th>Clasificación</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr class="cliente-row" data-clasificacion="@item.Clasificacion">
                                        <td>
                                            <a href="@Url.Action("Detalle", "Clientes", new { id = item.id_cliente })" class="fw-bold text-info" title="Ver ficha y contactos">
                                                @item.empresa
                                            </a>
                                        </td>
                                        <td>@item.nombre</td>
                                        <td>@item.correo</td>
                                        <td>@item.telefono</td>
                                        <td>
                                            <!-- Lead Scoring Progress Bar -->
                                            <div class="progress progress-xs mb-1" style="height: 6px;">
                                                <div class="progress-bar bg-@(item.LeadScore >= 70 ? "success" : (item.LeadScore >= 35 ? "warning" : "danger"))" 
                                                     role="progressbar" 
                                                     style="width: @(item.LeadScore)%;" 
                                                     aria-valuenow="@item.LeadScore" 
                                                     aria-valuemin="0" 
                                                     aria-valuemax="100"></div>
                                            </div>
                                            <span class="badge badge-@(item.LeadScore >= 70 ? "success" : (item.LeadScore >= 35 ? "warning" : "danger"))-light fw-bold fs-11">
                                                @item.LeadScore / 100 pts
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.Clasificacion == "VIP")
                                            {
                                                <span class="badge badge-success px-10 py-5">👑 VIP</span>
                                            }
                                            else if (item.Clasificacion == "Medio")
                                            {
                                                <span class="badge badge-warning px-10 py-5 text-dark">🤝 Medio</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary px-10 py-5 text-dark">❄️ Bajo</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.estado == "Activo" || item.estado == "1")
                                            {
                                                <span class="badge badge-success-light">Activo</span>
                                            }
                                            else if (item.estado != null && (item.estado.Contains("Negociac") || item.estado == "En Negociaci&oacute;n"))
                                            {
                                                <span class="badge badge-warning-light">En Negociación</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger-light">Inactivo</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="@Url.Action("Editar", "Clientes", new { id = item.id_cliente })" class="btn btn-sm btn-info-light" title="Editar">
                                                <i class="fa fa-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-danger-light" onclick="confirmarEliminar(@item.id_cliente, '@item.empresa')" title="Eliminar">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted">No hay clientes registrados en la base de datos.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        // Inicializar paginación
        paginarTabla('clientes-table', 5);

        // Filtro interactivo en cliente
        $('#btn-group-filter button').on('click', function() {
            $('#btn-group-filter button').removeClass('active');
            $(this).addClass('active');

            var filter = $(this).data('filter');
            if (filter === 'all') {
                $('.cliente-row').show();
            } else {
                $('.cliente-row').hide();
                $('.cliente-row[data-clasificacion="' + filter + '"]').show();
            }
            paginarTabla('clientes-table', 5);
        });
    });

    function paginarTabla(tableId, recordsPerPage) {
        const $table = $('#' + tableId);
        if ($table.length === 0) return;
        
        $('#' + tableId + '-pagination').remove();
        
        const $tbody = $table.find('tbody');
        const $rows = $tbody.find('tr').filter(function() {
            return $(this).css('display') !== 'none';
        });
        
        const totalRows = $rows.length;
        if (totalRows === 0) return;
        if (totalRows <= recordsPerPage) {
            $rows.show();
            return;
        }
        
        let currentPage = 1;
        const totalPages = Math.ceil(totalRows / recordsPerPage);
        
        const $navContainer = $('<div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2" id="' + tableId + '-pagination"></div>');
        const $infoText = $('<span class="text-muted small"></span>');
        const $paginationUl = $('<ul class="pagination pagination-sm mb-0"></ul>');
        
        $navContainer.append($infoText).append($paginationUl);
        $table.after($navContainer);
        
        function showPage(page) {
            currentPage = page;
            const start = (page - 1) * recordsPerPage;
            const end = start + recordsPerPage;
            
            $rows.hide();
            $rows.slice(start, end).show();
            
            const shownCount = Math.min(end, totalRows);
            $infoText.text('Mostrando del ' + (start + 1) + ' al ' + shownCount + ' de ' + totalRows + ' registros.');
            
            $paginationUl.empty();
            const $prevLi = $('<li class="page-item"><a class="page-link" href="javascript:void(0)">&laquo;</a></li>');
            if (currentPage === 1) $prevLi.addClass('disabled');
            else $prevLi.on('click', () => showPage(currentPage - 1));
            $paginationUl.append($prevLi);
            
            for (let i = 1; i <= totalPages; i++) {
                const $pageLi = $('<li class="page-item"><a class="page-link" href="javascript:void(0)">' + i + '</a></li>');
                if (i === currentPage) $pageLi.addClass('active');
                else $pageLi.on('click', () => showPage(i));
                $paginationUl.append($pageLi);
            }
            
            const $nextLi = $('<li class="page-item"><a class="page-link" href="javascript:void(0)">&raquo;</a></li>');
            if (currentPage === totalPages) $nextLi.addClass('disabled');
            else $nextLi.on('click', () => showPage(currentPage + 1));
            $paginationUl.append($nextLi);
        }
        
        showPage(1);
    }

    function confirmarEliminar(id, empresa) {
        var urlEliminar = '@Url.Action("Eliminar", "Clientes")';

        if (confirm("Sistema CRM-RSG: ¿Está seguro de que desea eliminar permanentemente a la empresa '" + empresa + "'?")) {
            $.ajax({
                url: urlEliminar,
                type: 'POST',
                data: { id: id },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert("Ocurrió un error en el servidor al intentar eliminar.");
                }
            });
        }
    }
</script>