@{
    ViewBag.Title = "Dashboard - CRM";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.BodyClass = "dashboard-page";
    int rolId = Session["RolId"] != null ? (int)Session["RolId"] : 2;
    bool isAdmin = rolId == 1;

    var chartFechas = (string[])ViewBag.EventosFechas;
    var chartCantidades = (int[])ViewBag.EventosCantidades;
}

<link rel="stylesheet" href="@Url.Content("~/Content/css/dashboard-custom.css")" />

<div class="box-body px-0 content-header d-lg-flex d-sm-block align-items-center justify-content-between" style="margin-bottom: 30px !important;">
    <h1>
        Dashboard CRM
        <small>@(isAdmin ? "Panel de Administrador" : "Panel de Empleado")</small>
    </h1>
    <div class="d-flex align-items-center">
        <!-- Filtro global dinámico de tiempo -->
        <div class="me-3">
            <select id="filtro-global" class="form-select border-primary fw-bold" style="width: 220px;">
                <option value="todos" @(ViewBag.FiltroActivo == "todos" ? "selected" : "")>⏰ Todos los tiempos</option>
                <option value="dia" @(ViewBag.FiltroActivo == "dia" ? "selected" : "")>📅 Hoy</option>
                <option value="semana" @(ViewBag.FiltroActivo == "semana" ? "selected" : "")>🗓️ Última Semana</option>
                <option value="mes" @(ViewBag.FiltroActivo == "mes" ? "selected" : "")>📊 Último Mes</option>
                <option value="anio" @(ViewBag.FiltroActivo == "anio" ? "selected" : "")>📈 Último Año</option>
            </select>
        </div>

        <div class="me-3">
            <a href="@Url.Action("ExportarClientesExcel", "Clientes")" class="btn btn-success d-flex align-items-center" style="background-color: #10c469; border-color: #10c469; color: white; font-weight: 500;">
                <i class="fa fa-file-excel-o me-2"></i> Exportar Clientes
            </a>
        </div>
        <ol class="breadcrumb p-0 m-0">
            <li class="breadcrumb-item"><a href="~/Dashboard"><i class="fa fa-dashboard"></i> Inicio</a></li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </div>
</div>

<!-- Tarjetas de Métricas Premium -->
<div class="row">
    <!-- Clientes Card -->
    <div class="col-xxl-3 col-xl-6 col-12">
        <div class="metric-card">
            <div class="d-flex align-items-center justify-content-between">
                <div class="icon-container" style="background: rgba(102, 16, 242, 0.1); color: #6610f2;">
                    <i class="ti-user text-primary"></i>
                </div>
                <span class="trend up"><i class="fa fa-arrow-up me-1"></i> 12.5%</span>
            </div>
            <div class="label">Clientes @(isAdmin ? "Totales" : "Asignados")</div>
            <div class="value">@ViewBag.TotalClientes</div>
            <div class="text-muted fs-11 mt-10">vs el mes anterior</div>
        </div>
    </div>

    <!-- Oportunidades Card -->
    <div class="col-xxl-3 col-xl-6 col-12">
        <div class="metric-card">
            <div class="d-flex align-items-center justify-content-between">
                <div class="icon-container" style="background: rgba(45, 206, 137, 0.1); color: #2dce89;">
                    <i class="ti-money"></i>
                </div>
                <span class="trend up"><i class="fa fa-arrow-up me-1"></i> 15.3%</span>
            </div>
            <div class="label">Oportunidades @(isAdmin ? "Activas" : "Mías")</div>
            <div class="value">@ViewBag.TotalOportunidades</div>
            <div class="text-muted fs-11 mt-10">vs el mes anterior</div>
        </div>
    </div>

    <!-- Tareas Card -->
    <div class="col-xxl-3 col-xl-6 col-12">
        <div class="metric-card">
            <div class="d-flex align-items-center justify-content-between">
                <div class="icon-container" style="background: rgba(255, 159, 67, 0.1); color: #ff9f43;">
                    <i class="ti-check-box"></i>
                </div>
                <span class="trend down"><i class="fa fa-arrow-down me-1"></i> 5.4%</span>
            </div>
            <div class="label">Tareas Pendientes</div>
            <div class="value">@ViewBag.TotalTareas</div>
            <div class="text-muted fs-11 mt-10">vs la semana anterior</div>
        </div>
    </div>

    <!-- Usuarios Card -->
    <div class="col-xxl-3 col-xl-6 col-12">
        <div class="metric-card">
            <div class="d-flex align-items-center justify-content-between">
                <div class="icon-container" style="background: rgba(0, 123, 255, 0.1); color: #007bff;">
                    <i class="ti-bar-chart"></i>
                </div>
                <span class="trend up"><i class="fa fa-arrow-up me-1"></i> 8.2%</span>
            </div>
            <div class="label">Usuarios Activos</div>
            <div class="value">@ViewBag.TotalUsuarios</div>
            <div class="text-muted fs-11 mt-10">vs el mes anterior</div>
        </div>
    </div>
</div>

<!-- Gráficos de Eventos / Citas (HU-025) -->
<div class="row">
    <div class="col-xxl-8 col-xl-8 col-lg-12 col-12">
        <div class="box">
            <div class="box-header with-border">
                <h4 class="box-title" style="color: #040A2D;">Cantidad de Citas Agendadas</h4>
            </div>
            <div class="box-body">
                <div id="eventos-line-chart" class="chart-responsive"></div>
            </div>
        </div>
    </div>

    <div class="col-xxl-4 col-xl-4 col-lg-12 col-12">
        <div class="box">
            <div class="box-header with-border">
                <h4 class="box-title" style="color: #040A2D;">Proporción por Estados de Citas</h4>
            </div>
            <div class="box-body">
                <div id="estados-donut-chart" class="chart-responsive"></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Lista de Tareas Próximas -->
    <div class="col-xxl-6 col-xl-6 col-lg-12 col-12">
        <div class="box">
            <div class="box-header with-border d-flex justify-content-between align-items-center">
                <h4 class="box-title">@(isAdmin ? "Todas las Tareas Pendientes" : "Mis Tareas Pendientes")</h4>
                <a href="~/Tareas" class="btn btn-sm btn-primary-light">Ver todo</a>
            </div>
            <div class="box-body p-0">
                <div class="media-list media-list-hover media-list-divided">
                    @if (((List<CRMRSG.EntityFramework.tarea>)ViewBag.TareasProximas).Count == 0)
                    {
                        <div class="p-20 text-center text-muted">No hay tareas pendientes para este período.</div>
                    }
                    @foreach (var t in (List<CRMRSG.EntityFramework.tarea>)ViewBag.TareasProximas)
                    {
                        <a class="media media-single" href="~/Tareas">
                            <div class="me-10 d-flex align-items-center">
                                <i class="fa fa-circle text-@(t.prioridad == "Alta" ? "danger" : (t.prioridad == "Media" ? "warning" : "info")) fs-10"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0 fw-bold">@t.titulo</h6>
                                <small class="text-fade">Vence: @(t.fecha_limite.HasValue ? t.fecha_limite.Value.ToString("dd/MM/yyyy") : "Sin fecha")</small>
                            </div>
                            <span class="badge badge-@(t.prioridad == "Alta" ? "danger" : (t.prioridad == "Media" ? "warning" : "info"))-light">@t.prioridad</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de Actividades Recientes (Bitácora) -->
    <div class="col-xxl-6 col-xl-6 col-lg-12 col-12">
        <div class="box">
            <div class="box-header with-border">
                <h4 class="box-title">Últimas Acciones en el Sistema</h4>
            </div>
            <div class="box-body p-0">
                <div class="media-list media-list-hover media-list-divided">
                    @if (((List<CRMRSG.EntityFramework.bitacora>)ViewBag.ActividadesRecientes).Count == 0)
                    {
                        <div class="p-20 text-center text-muted">No se registran actividades recientes.</div>
                    }
                    @foreach (var act in (List<CRMRSG.EntityFramework.bitacora>)ViewBag.ActividadesRecientes)
                    {
                        string desc = "";
                        string modulo = act.tabla_afectada ?? "";
                        if (modulo == "clientes") { modulo = "Clientes"; }
                        else if (modulo == "oportunidades") { modulo = "Oportunidades"; }
                        else if (modulo == "tareas") { modulo = "Tareas"; }
                        else if (modulo == "citas") { modulo = "Citas / Eventos"; }
                        else if (modulo == "usuarios") { modulo = "Usuarios"; }
                        else if (modulo == "contacto_cliente") { modulo = "Contactos"; }
                        else if (modulo == "nota_cliente") { modulo = "Notas"; }

                        if (act.accion == "Creación")
                        {
                            desc = $"Creó un nuevo registro en {modulo}.";
                        }
                        else if (act.accion == "Modificación")
                        {
                            desc = $"Modificó un registro en {modulo}.";
                        }
                        else if (act.accion == "Eliminación")
                        {
                            desc = $"Eliminó un registro de {modulo}.";
                        }
                        else
                        {
                            desc = $"{act.accion} en {modulo}.";
                        }
                        <div class="media media-single">
                            <div class="flex-grow-1">
                                <h6 class="mb-0 fw-bold">@desc</h6>
                                <p class="text-muted fs-12 mb-0">Realizado por: @(act.usuario != null ? act.usuario.nombre + " " + act.usuario.apellido : "Sistema")</p>
                            </div>
                            <span class="badge badge-primary-light">
                                @(act.fecha_hora.HasValue ? act.fecha_hora.Value.ToString("HH:mm") : "")
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- HU-031 & HU-032 Row -->
<div class="row">
    <!-- Recomendaciones Inteligentes (HU-031) -->
    <div class="col-xxl-6 col-xl-6 col-12">
        <div class="box">
            <div class="box-header with-border">
                <h4 class="box-title text-success"><i class="fa fa-lightbulb-o me-2"></i> Recomendaciones Inteligentes de Seguimiento</h4>
            </div>
            <div class="box-body">
                <div class="media-list media-list-hover media-list-divided">
                    @if (ViewBag.Recomendaciones != null && ((List<CRMRSG.Controllers.RecomendacionSeguimiento>)ViewBag.Recomendaciones).Any())
                    {
                        foreach (var rec in (List<CRMRSG.Controllers.RecomendacionSeguimiento>)ViewBag.Recomendaciones)
                        {
                            <div class="media media-single p-15 border mb-10 rounded">
                                <div class="bg-@rec.Tipo-light rounded-circle p-10 me-15 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; display: inline-flex !important;">
                                    <i class="fa @(rec.Tipo == "success" ? "fa-dollar" : (rec.Tipo == "warning" ? "fa-warning" : "fa-info")) text-@rec.Tipo"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-0 fw-bold">@rec.Titulo</h6>
                                    <p class="text-fade fs-12 mb-0">@rec.Mensaje</p>
                                </div>
                                <a href="@rec.Accion" class="btn btn-sm btn-outline-primary">Proceder</a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-20 text-center text-muted">No se registran recomendaciones en este momento. ¡Buen trabajo con tus clientes!</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Generación Inteligente de Correos (HU-032) -->
    <div class="col-xxl-6 col-xl-6 col-12">
        <div class="box">
            <div class="box-header with-border d-flex justify-content-between align-items-center">
                <h4 class="box-title text-primary"><i class="fa fa-magic me-2"></i> Redactor de Correos Inteligente</h4>
                <div class="btn-group">
                    <button type="button" class="btn btn-xs btn-success" id="btn-nueva-plantilla" title="Nueva Plantilla"><i class="fa fa-plus"></i> Nueva</button>
                    <button type="button" class="btn btn-xs btn-primary" id="btn-guardar-plantilla" title="Guardar Plantilla"><i class="fa fa-save"></i> Guardar</button>
                    <button type="button" class="btn btn-xs btn-danger" id="btn-eliminar-plantilla" title="Eliminar Plantilla"><i class="fa fa-trash"></i> Eliminar</button>
                </div>
            </div>
            <div class="box-body">
                <div class="row mb-15">
                    <div class="col-md-4">
                        <label class="form-label">Cliente</label>
                        <select id="email-cliente" class="form-select">
                            <option value="">-- Seleccionar --</option>
                            @if (ViewBag.ClientesEmail != null)
                            {
                                foreach (var c in (List<CRMRSG.EntityFramework.cliente>)ViewBag.ClientesEmail)
                                {
                                    <option value="@c.id_cliente" data-nombre="@c.nombre" data-empresa="@c.empresa" data-email="@c.correo">@c.nombre (@c.empresa)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Correo Destinatario</label>
                        <input type="email" id="email-destinatario" class="form-control" placeholder="ejemplo@correo.com" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Plantilla</label>
                        <select id="email-plantilla" class="form-select">
                            <option value="bienvenida">Bienvenida Comercial</option>
                            <option value="seguimiento">Seguimiento Comercial</option>
                            <option value="reunion">Recordatorio de Reunión</option>
                        </select>
                    </div>
                </div>
                <div class="form-group mb-15">
                    <label class="form-label">Asunto del Correo</label>
                    <input type="text" id="email-asunto" class="form-control" placeholder="Escriba el asunto aquí..." />
                </div>
                <div class="form-group mb-10">
                    <label class="form-label">Cuerpo del Correo</label>
                    <textarea id="email-cuerpo" class="form-control" rows="4" placeholder="Escriba el cuerpo aquí..."></textarea>
                </div>
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-info text-white" id="btn-copiar-correo">
                            <i class="fa fa-copy me-1"></i> Copiar
                        </button>
                        <button type="button" class="btn btn-sm btn-success" id="btn-enviar-correo-now">
                            <i class="fa fa-send me-1"></i> Enviar Ahora
                        </button>
                        <button type="button" class="btn btn-sm btn-primary" id="btn-toggle-programar">
                            <i class="fa fa-clock-o me-1"></i> Programar Envío
                        </button>
                    </div>
                </div>
                
                <!-- Collapse para programar envío -->
                <div class="card bg-light mt-3 p-3 border-0 rounded" id="programar-collapse" style="display: none;">
                    <h6 class="fw-bold mb-2">Programar fecha y hora de envío:</h6>
                    <div class="d-flex gap-2 align-items-center">
                        <input type="datetime-local" id="programar-fecha-hora" class="form-control form-control-sm" style="max-width: 250px;" />
                        <button type="button" class="btn btn-sm btn-primary" id="btn-confirmar-programar">Confirmar Programación</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xxl-6 col-xl-6 col-12">
        <div class="box">
            <div class="box-header with-border d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h4 class="box-title" style="color: #040A2D;">Ganancias por Cliente (Oportunidades Ganadas)</h4>
                <h4 class="text-success fw-bold mb-0">Total: ₡@(ViewBag.GananciasTotales.ToString("N0"))</h4>
            </div>
            <div class="box-body">
                <div id="ganancias-bar-chart" style="min-height: 250px;"></div>
            </div>
        </div>
    </div>

    <!-- Rendimiento de Vendedores (HU-035) - Solo visible para Administradores -->
    @if (isAdmin)
    {
        <div class="col-xxl-6 col-xl-6 col-12">
            <div class="box">
                <div class="box-header with-border">
                    <h4 class="box-title">Rendimiento y Productividad de Vendedores</h4>
                </div>
                <div class="box-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0" style="font-size: 13px;">
                            <thead class="bg-light">
                                <tr>
                                    <th style="min-width: 140px;">Colaborador / Vendedor</th>
                                    <th class="text-center" style="min-width: 80px;">Clientes</th>
                                    <th class="text-center" style="min-width: 100px;">Oportunidades</th>
                                    <th class="text-center" style="min-width: 75px;">Tareas</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in (IEnumerable<CRMRSG.Controllers.VendedorRendimiento>)ViewBag.Vendedores)
                                {
                                    <tr style="border-bottom: 1px solid #e9ecef;">
                                        <td class="fw-bold text-dark">@item.Nombre</td>
                                        <td class="text-center">
                                            <span class="badge badge-info-light fs-11">@item.Clientes</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-success-light fs-11">@item.Oportunidades</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-warning-light fs-11">@item.Tareas</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section scripts {
    <script src="@Url.Content("~/Content/assets/vendor_components/apexcharts-bundle/dist/apexcharts.js")"></script>

    <script>
        $(document).ready(function () {
            // Manejador del filtro global de tiempo
            $('#filtro-global').on('change', function() {
                window.location.href = '@Url.Action("Index", "Dashboard")?filtro=' + $(this).val();
            });

            // Obtener paleta de colores para gráficos desde localStorage (HU-038)
            var chartPalette = localStorage.getItem('crm_chart_palette') || 'classic';
            var palettes = {
                classic: {
                    line: ['#1d3557'],
                    donut: ['#2a9d8f', '#f4a261', '#e63946', '#1d3557'],
                    bar: ['#1d3557', '#e63946', '#457b9d', '#a8dadc', '#f4a261']
                },
                ocean: {
                    line: ['#0077b6'],
                    donut: ['#0096c7', '#00b4d8', '#48cae4', '#90e0ef'],
                    bar: ['#03045e', '#023e8a', '#0077b6', '#0096c7', '#00b4d8']
                },
                neon: {
                    line: ['#7209b7'],
                    donut: ['#f72585', '#7209b7', '#3f37c9', '#4cc9f0'],
                    bar: ['#f72585', '#b5179e', '#7209b7', '#480ca8', '#3f37c9']
                },
                sunset: {
                    line: ['#d90429'],
                    donut: ['#d90429', '#f77f00', '#fcbf49', '#eae2b7'],
                    bar: ['#d90429', '#ef233c', '#f77f00', '#fcbf49', '#eae2b7']
                },
                forest: {
                    line: ['#2c6e49'],
                    donut: ['#2c6e49', '#4c956c', '#a3b18a', '#588157'],
                    bar: ['#1b4332', '#2d6a4f', '#40916c', '#52b788', '#74c69d']
                }
            };
            var selectedColors = palettes[chartPalette] || palettes.classic;
            if (chartPalette === 'custom') {
                var customColorsStr = localStorage.getItem('crm_custom_chart_colors');
                var customColors = ['#2a9d8f', '#f4a261', '#e63946'];
                if (customColorsStr) {
                    try { customColors = JSON.parse(customColorsStr); } catch(e) {}
                }
                selectedColors = {
                    line: [customColors[0]],
                    donut: customColors,
                    bar: customColors
                };
            }

            // Determinar si el tema es oscuro para ApexCharts (HU-038)
            var boxBgColor = localStorage.getItem('crm_box_bg_color') || '#ffffff';
            var r = parseInt(boxBgColor.substr(1, 2), 16);
            var g = parseInt(boxBgColor.substr(3, 2), 16);
            var b = parseInt(boxBgColor.substr(5, 2), 16);
            var yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
            var chartThemeMode = (yiq < 128) ? 'dark' : 'light';
            var chartLabelColor = (yiq < 128) ? '#ffffff' : '#5a6a85';

            // Gráfico de Citas por Fecha - ApexCharts
            if ($('#eventos-line-chart').length > 0) {
                var fechas = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(chartFechas));
                var cantidades = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(chartCantidades));

                var optionsLine = {
                    series: [{ name: 'Citas', data: cantidades }],
                    chart: { type: 'area', height: 240, toolbar: { show: false }, background: 'transparent', redrawOnWindowResize: true },
                    theme: { mode: chartThemeMode },
                    stroke: { curve: 'smooth', width: 2 },
                    xaxis: { 
                        categories: fechas,
                        labels: { style: { colors: chartLabelColor } }
                    },
                    yaxis: {
                        labels: { style: { colors: chartLabelColor } }
                    },
                    colors: selectedColors.line,
                    fill: {
                        type: 'gradient',
                        gradient: {
                            shadeIntensity: 1,
                            opacityFrom: 0.3,
                            opacityTo: 0.05,
                            stops: [0, 90, 100]
                        }
                    },
                    dataLabels: { enabled: false }
                };
                new ApexCharts(document.querySelector("#eventos-line-chart"), optionsLine).render();
            }

            // Gráfico de Citas por Estado - Donut Chart
            if ($('#estados-donut-chart').length > 0) {
                var completados = @ViewBag.EventosCompletados;
                var pendientes = @ViewBag.EventosPendientes;
                var cancelados = @ViewBag.EventosCancelados;
                var aplazados = @(ViewBag.EventosAplazados ?? 0);

                var optionsDonut = {
                    series: [completados, pendientes, cancelados, aplazados],
                    chart: { type: 'donut', height: 240, background: 'transparent', redrawOnWindowResize: true },
                    theme: { mode: chartThemeMode },
                    labels: ['Completadas', 'Pendientes', 'Canceladas', 'Aplazadas'],
                    colors: selectedColors.donut,
                    legend: { 
                        position: 'bottom',
                        horizontalAlign: 'center',
                        floating: false,
                        labels: { colors: chartLabelColor }
                    },
                    stroke: { colors: [boxBgColor], width: 2 }
                };
                new ApexCharts(document.querySelector("#estados-donut-chart"), optionsDonut).render();
            }

            // Gráfico de Ganancias por Cliente - Bar Chart
            if ($('#ganancias-bar-chart').length > 0) {
                var clientesGanancias = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.GananciasLabels));
                var montosGanancias = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.GananciasData));

                var optionsBar = {
                    series: [{
                        name: 'Ganancias',
                        data: montosGanancias
                    }],
                    chart: {
                        type: 'bar',
                        height: 320,
                        toolbar: { show: false },
                        background: 'transparent',
                        sparkline: { enabled: false },
                        redrawOnWindowResize: true
                    },
                    theme: { mode: chartThemeMode },
                    plotOptions: {
                        bar: {
                            borderRadius: 8,
                            horizontal: false,
                            columnWidth: '55%',
                            distributed: true,
                            dataLabels: {
                                position: 'top'
                            }
                        }
                    },
                    dataLabels: {
                        enabled: true,
                        formatter: function (val) {
                            return "₡" + Math.floor(val).toLocaleString();
                        },
                        style: {
                            colors: [chartThemeMode === 'dark' ? '#FFFFFF' : '#000000'],
                            fontSize: '11px',
                            fontWeight: 600
                        },
                        offsetY: -20
                    },
                    colors: selectedColors.bar,
                    xaxis: {
                        categories: clientesGanancias,
                        labels: {
                            style: {
                                colors: chartLabelColor,
                                fontWeight: 600,
                                fontSize: '11px'
                            },
                            maxHeight: 120,
                            hideOverlappingLabels: true
                        }
                    },
                    yaxis: {
                        title: {
                            text: 'Monto (₡)',
                            style: {
                                color: chartLabelColor,
                                fontWeight: 600
                            }
                        },
                        labels: {
                            formatter: function (val) {
                                return "₡" + Math.floor(val).toLocaleString();
                            },
                            style: {
                                colors: chartLabelColor,
                                fontSize: '11px'
                            }
                        }
                    },
                    grid: {
                        borderColor: chartThemeMode === 'dark' ? '#444' : '#ededed',
                        strokeDashArray: 4,
                        xaxis: {
                            lines: { show: false }
                        }
                    },
                    tooltip: {
                        enabled: true,
                        theme: chartThemeMode,
                        y: {
                            formatter: function(val) {
                                return "₡" + Math.floor(val).toLocaleString();
                            }
                        }
                    },
                    legend: {
                        position: 'bottom',
                        horizontalAlign: 'center',
                        labels: { colors: chartLabelColor }
                    }
                };
                new ApexCharts(document.querySelector("#ganancias-bar-chart"), optionsBar).render();
            }

            // Script para Redactor de Correos Inteligente (HU-032)
            const baseTemplates = {
                bienvenida: {
                    asunto: "¡Le damos la bienvenida, {nombre}! - Alianza Comercial",
                    cuerpo: "Estimado(a) {nombre},\n\nEs un verdadero honor darle la bienvenida a nuestra familia empresarial. En nombre de todo nuestro equipo, le extendemos un cordial saludo a usted y a todo el personal de {empresa}.\n\nNos entusiasma enormemente comenzar esta alianza estratégica. Nuestro principal objetivo es colaborar estrechamente con {empresa} para optimizar sus procesos comerciales y potenciar sus metas de negocio de manera integral.\n\nPronto uno de nuestros directores comerciales le estará contactando para programar una llamada de inducción y alinear nuestras próximas acciones de trabajo. Mientras tanto, quedamos a su entera disposición ante cualquier duda o requerimiento técnico."
                },
                seguimiento: {
                    asunto: "Seguimiento de propuesta comercial - {empresa}",
                    cuerpo: "Estimado(a) {nombre},\n\nEspero que este mensaje le encuentre excelente.\n\nLe escribo para dar seguimiento a la propuesta comercial que compartimos recientemente con {empresa}. En nuestro último contacto, conversamos sobre las áreas de oportunidad de su departamento de ventas, y cómo nuestras herramientas personalizadas pueden ayudarle a acelerar su conversión comercial.\n\n¿Ha tenido oportunidad de revisar la propuesta técnica? Estaremos encantados de agendar una breve llamada de 10 minutos esta semana para resolver sus preguntas o ajustar el alcance del proyecto según sus prioridades."
                },
                reunion: {
                    asunto: "Confirmación de nuestra próxima sesión - {empresa}",
                    cuerpo: "Estimado(a) {nombre},\n\nConfirmamos por este medio los detalles de nuestra próxima sesión de trabajo de consultoría y seguimiento comercial para {empresa}:\n\n📅 Fecha: En los próximos días\n📍 Modalidad: Videoconferencia en línea\n📋 Agenda básica: Revisión del lead scoring de clientes, prioridades en cartera, y demostración del nuevo redactor de correos inteligente del CRM.\n\nLe agradecemos de antemano su puntualidad y valioso tiempo. Si surge algún imprevisto que requiera reprogramar la cita, por favor háganoslo saber con anticipación."
                }
            };

            function getTemplates() {
                let custom = localStorage.getItem('crm_custom_templates');
                let templates = {...baseTemplates};
                if (custom) {
                    try {
                        let parsed = JSON.parse(custom);
                        Object.assign(templates, parsed);
                    } catch(e) {}
                }
                return templates;
            }

            function renderTemplateDropdown() {
                const templates = getTemplates();
                const $select = $('#email-plantilla');
                const val = $select.val() || 'bienvenida';
                $select.empty();
                for (const [key, t] of Object.entries(templates)) {
                    let label = key === 'bienvenida' ? 'Bienvenida Comercial' :
                                key === 'seguimiento' ? 'Seguimiento Comercial' :
                                key === 'reunion' ? 'Recordatorio de Reunión' : key;
                    $select.append(`<option value="${key}">${label}</option>`);
                }
                $select.val(val);
            }

            function cargarTemplateSeleccionada() {
                const templates = getTemplates();
                const key = $('#email-plantilla').val();
                const opt = $('#email-cliente option:selected');
                const nombre = opt.data('nombre') || '{nombre}';
                const empresa = opt.data('empresa') || '{empresa}';
                
                if (key && templates[key]) {
                    let t = templates[key];
                    let subject = t.asunto.replace(/{nombre}/g, nombre).replace(/{empresa}/g, empresa);
                    let body = t.cuerpo.replace(/{nombre}/g, nombre).replace(/{empresa}/g, empresa);
                    $('#email-asunto').val(subject);
                    $('#email-cuerpo').val(body);
                }
            }

            // Inicializar templates
            renderTemplateDropdown();
            cargarTemplateSeleccionada();

            // Sincronizar correo e inputs al cambiar cliente
            $('#email-cliente').on('change', function() {
                const opt = $('option:selected', this);
                $('#email-destinatario').val(opt.data('email') || '');
                cargarTemplateSeleccionada();
            });

            $('#email-plantilla').on('change', cargarTemplateSeleccionada);

            // Crear plantilla nueva (vacía)
            $('#btn-nueva-plantilla').on('click', function() {
                Swal.fire({
                    title: 'Nueva Plantilla Personalizada',
                    input: 'text',
                    inputLabel: 'Nombre de la Plantilla',
                    placeholder: 'Ej: Recordatorio de Pago',
                    showCancelButton: true,
                    confirmButtonText: 'Crear',
                    cancelButtonText: 'Cancelar',
                    inputValidator: (value) => {
                        if (!value) return '¡Debe escribir un nombre!';
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        const name = result.value.trim();
                        $('#email-asunto').val('');
                        $('#email-cuerpo').val('');
                        
                        $('#email-plantilla').append(`<option value="${name}">${name}</option>`).val(name);
                        Swal.fire('Plantilla Creada', 'Escriba el asunto y cuerpo de su plantilla, luego pulse el botón azul "Guardar".', 'info');
                    }
                });
            });

            // Guardar cambios en plantilla activa
            $('#btn-guardar-plantilla').on('click', function() {
                const key = $('#email-plantilla').val();
                const asunto = $('#email-asunto').val();
                const cuerpo = $('#email-cuerpo').val();
                if (!key) {
                    Swal.fire('Error', 'Seleccione o cree una plantilla primero.', 'error');
                    return;
                }
                
                let custom = localStorage.getItem('crm_custom_templates');
                let customObj = {};
                if (custom) {
                    try { customObj = JSON.parse(custom); } catch(e) {}
                }
                
                customObj[key] = { asunto: asunto, cuerpo: cuerpo };
                localStorage.setItem('crm_custom_templates', JSON.stringify(customObj));
                
                Swal.fire('Guardada', 'Plantilla guardada con éxito en tu navegador.', 'success');
                renderTemplateDropdown();
            });

            // Eliminar plantilla
            $('#btn-eliminar-plantilla').on('click', function() {
                const key = $('#email-plantilla').val();
                if (key === 'bienvenida' || key === 'seguimiento' || key === 'reunion') {
                    Swal.fire('No permitido', 'No puede eliminar las plantillas por defecto del sistema.', 'warning');
                    return;
                }
                
                Swal.fire({
                    title: '¿Eliminar plantilla?',
                    text: `¿Desea borrar permanentemente la plantilla "${key}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, borrar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let custom = localStorage.getItem('crm_custom_templates');
                        if (custom) {
                            try {
                                let customObj = JSON.parse(custom);
                                delete customObj[key];
                                localStorage.setItem('crm_custom_templates', JSON.stringify(customObj));
                            } catch(e) {}
                        }
                        Swal.fire('Eliminada', 'La plantilla ha sido borrada.', 'success');
                        $('#email-plantilla').val('bienvenida');
                        renderTemplateDropdown();
                        cargarTemplateSeleccionada();
                    }
                });
            });

            // Copiar al portapapeles
            $('#btn-copiar-correo').on('click', function() {
                const asunto = $('#email-asunto').val();
                const cuerpo = $('#email-cuerpo').val();
                if (!asunto || !cuerpo) {
                    Swal.fire('Error', 'No hay contenido para copiar.', 'error');
                    return;
                }
                const textoCompleto = `Asunto: ${asunto}\n\n${cuerpo}`;
                navigator.clipboard.writeText(textoCompleto).then(() => {
                    Swal.fire({
                        title: '¡Copiado!',
                        text: 'El correo se copió al portapapeles con éxito.',
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    });
                });
            });

            // Toggle programación
            $('#btn-toggle-programar').on('click', function() {
                $('#programar-collapse').slideToggle();
            });

            // Enviar Correo Ahora AJAX
            $('#btn-enviar-correo-now').on('click', function() {
                const dest = $('#email-destinatario').val();
                const asun = $('#email-asunto').val();
                const cuer = $('#email-cuerpo').val();

                if (!dest || !asun || !cuer) {
                    Swal.fire('Campos requeridos', 'Debe ingresar el destinatario, asunto y cuerpo del correo.', 'warning');
                    return;
                }

                Swal.fire({
                    title: 'Enviando correo...',
                    html: 'Por favor espere un momento.',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '@Url.Action("EnviarCorreo", "Dashboard")',
                    type: 'POST',
                    data: { destinatario: dest, asunto: asun, cuerpo: cuer },
                    success: function(res) {
                        Swal.close();
                        if (res.success) {
                            Swal.fire('¡Enviado!', res.message, 'success');
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.close();
                        Swal.fire('Error', 'Error de red al enviar el correo.', 'error');
                    }
                });
            });

            // Programar Envío AJAX
            $('#btn-confirmar-programar').on('click', function() {
                const dest = $('#email-destinatario').val();
                const asun = $('#email-asunto').val();
                const cuer = $('#email-cuerpo').val();
                const fecha = $('#programar-fecha-hora').val();

                if (!dest || !asun || !cuer || !fecha) {
                    Swal.fire('Campos requeridos', 'Por favor complete todos los datos, incluyendo la fecha y hora programada.', 'warning');
                    return;
                }

                Swal.fire({
                    title: 'Programando correo...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '@Url.Action("ProgramarCorreo", "Dashboard")',
                    type: 'POST',
                    data: { destinatario: dest, asunto: asun, cuerpo: cuer, fechaProgramada: fecha },
                    success: function(res) {
                        Swal.close();
                        if (res.success) {
                            Swal.fire('¡Programado!', res.message, 'success');
                            $('#programar-collapse').slideUp();
                            $('#programar-fecha-hora').val('');
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.close();
                        Swal.fire('Error', 'Error al procesar la solicitud de programación.', 'error');
                    }
                });
            });

            
            $('.btn-cambiar-color').on('click', function () {
                const colorTema = $(this).data('color'); // Ej: '#4e73df', '#1cc88a', etc.
                
                // Cambia el color de fondo de las tarjetas o botones principales
                $('.card-email-header').css('background-color', colorTema);
                $('#btn-enviar-correo-now').css('background-color', colorTema);

                // Guardar preferencia de color del usuario
                localStorage.setItem('crm_email_theme_color', colorTema);
            });

            // Restaurar color guardado al cargar la página
            const savedColor = localStorage.getItem('crm_email_theme_color');
            if (savedColor) {
                $('.card-email-header').css('background-color', savedColor);
                $('#btn-enviar-correo-now').css('background-color', savedColor);
            }

            // Mejorar contraste de títulos en modo oscuro (HU-038)
            var boxBgColorForTitle = localStorage.getItem('crm_box_bg_color') || '#ffffff';
            var rTitle = parseInt(boxBgColorForTitle.substr(1, 2), 16);
            var gTitle = parseInt(boxBgColorForTitle.substr(3, 2), 16);
            var bTitle = parseInt(boxBgColorForTitle.substr(5, 2), 16);
            var yiqTitle = ((rTitle * 299) + (gTitle * 587) + (bTitle * 114)) / 1000;

            if (yiqTitle < 128) {
                // Modo oscuro: aplicar texto blanco a títulos
                $('.box-header .box-title').css('color', '#ffffff');
                $('.box-header h4').css('color', '#ffffff');
            }

        });
    </script>
}