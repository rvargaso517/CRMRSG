@model List<CRMRSG.EntityFramework.tarea>

@{
    ViewBag.Title = "Tareas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuarios = (List<CRMRSG.EntityFramework.usuario>)ViewBag.Usuarios;
    var selectedId = (int?)ViewBag.SelectedUsuarioId;

    var userLabels = (string[])ViewBag.UserLabels;
    var userValues = (int[])ViewBag.UserValues;

    var categoryLabels = (string[])ViewBag.CategoryLabels;
    var categoryValues = (int[])ViewBag.CategoryValues;

    var priorityLabels = (string[])ViewBag.PriorityLabels;
    var priorityValues = (int[])ViewBag.PriorityValues;
}

<div class="content-header">
    <div class="d-flex align-items-center">
        <div class="me-auto">
            <h4 class="page-title">Gestión de Tareas</h4>
            <div class="d-inline-block align-items-center">
                <nav>
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="~/Dashboard">
                                <i class="mdi mdi-home-outline"></i>
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            Tareas
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Filtros y Selección de Usuario -->
<div class="row">
    <div class="col-12 mb-20">
        <div class="box">
            <div class="box-body py-15">
                @using (Html.BeginForm("Index", "Tareas", FormMethod.Get, new { @class = "row align-items-end" }))
                {
                    if (usuarios != null && usuarios.Count > 1)
                    {
                        <div class="col-md-5 col-12 form-group mb-0">
                            <label class="form-label">Propietario / Asignado</label>
                            <select name="usuarioId" class="form-select">
                                <option value="">-- Todos los Usuarios --</option>
                                @foreach (var user in usuarios)
                                {
                                    <option value="@user.id_usuario" @(selectedId == user.id_usuario ? "selected" : "")>
                                        @user.nombre @user.apellido
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 col-12 form-group mb-0">
                            <label class="form-label">Rango Temporal (Fecha Límite)</label>
                            <select name="filtroFecha" class="form-select">
                                <option value="todos" @(ViewBag.FiltroFechaActivo == "todos" ? "selected" : "")>⏰ Todos los tiempos</option>
                                <option value="hoy" @(ViewBag.FiltroFechaActivo == "hoy" ? "selected" : "")>📅 Hoy</option>
                                <option value="manana" @(ViewBag.FiltroFechaActivo == "manana" ? "selected" : "")>🌅 Mañana</option>
                                <option value="semana" @(ViewBag.FiltroFechaActivo == "semana" ? "selected" : "")>🗓️ Próximos 7 días</option>
                                <option value="mes" @(ViewBag.FiltroFechaActivo == "mes" ? "selected" : "")>📊 Próximos 30 días</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-12 form-group mb-0">
                            <button type="submit" class="btn btn-primary w-100" style="height: 38px; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-filter me-2"></i> Aplicar Filtro
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-9 col-12 form-group mb-0">
                            <label class="form-label">Rango Temporal (Fecha Límite)</label>
                            <select name="filtroFecha" class="form-select">
                                <option value="todos" @(ViewBag.FiltroFechaActivo == "todos" ? "selected" : "")>⏰ Todos los tiempos</option>
                                <option value="hoy" @(ViewBag.FiltroFechaActivo == "hoy" ? "selected" : "")>📅 Hoy</option>
                                <option value="manana" @(ViewBag.FiltroFechaActivo == "manana" ? "selected" : "")>🌅 Mañana</option>
                                <option value="semana" @(ViewBag.FiltroFechaActivo == "semana" ? "selected" : "")>🗓️ Próximos 7 días</option>
                                <option value="mes" @(ViewBag.FiltroFechaActivo == "mes" ? "selected" : "")>📊 Próximos 30 días</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-12 form-group mb-0">
                            <button type="submit" class="btn btn-primary w-100" style="height: 38px; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-filter me-2"></i> Aplicar Filtro
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Gráficos de Estadísticas -->
<div class="row">
    @if (selectedId == null)
    {
        <!-- Tareas por Usuario -->
        <div class="col-xl-4 col-12">
            <div class="box">
                <div class="box-header with-border">
                    <h4 class="box-title" style="color: #040A2D;">@(ViewBag.UserChartTitle ?? "Carga por Usuario")</h4>
                </div>
                <div class="box-body">
                    <div id="user-task-chart"></div>
                </div>
            </div>
        </div>
        <!-- Categoría de Tareas -->
        <div class="col-xl-4 col-12">
            <div class="box">
                <div class="box-header with-border">
                    <h4 class="box-title" style="color: #040A2D;">Tareas por Estado</h4>
                </div>
                <div class="box-body">
                    <div id="category-task-chart"></div>
                </div>
            </div>
        </div>
        <!-- Tareas por Prioridad -->
        <div class="col-xl-4 col-12">
            <div class="box">
                <div class="box-header with-border">
                    <h4 class="box-title" style="color: #040A2D;">Distribución de Prioridades</h4>
                </div>
                <div class="box-body">
                    <div id="priority-task-chart"></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Categoría de Tareas -->
        <div class="col-xl-6 col-12">
            <div class="box">
                <div class="box-header with-border">
                    <h4 class="box-title" style="color: #040A2D;">Tareas por Estado</h4>
                </div>
                <div class="box-body">
                    <div id="category-task-chart"></div>
                </div>
            </div>
        </div>
        <!-- Tareas por Prioridad -->
        <div class="col-xl-6 col-12">
            <div class="box">
                <div class="box-header with-border">
                    <h4 class="box-title" style="color: #040A2D;">Distribución de Prioridades</h4>
                </div>
                <div class="box-body">
                    <div id="priority-task-chart"></div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Listado de Tareas -->
<div class="row">
    <div class="col-12">
        <div class="box" id="tareas-box">
            <div class="box-header with-border d-flex justify-content-between align-items-center">
                <h3 class="box-title">Listado General de Tareas</h3>
                <a href="~/Tareas/Crear" class="btn btn-primary">
                    <i class="fa fa-plus"></i> Nueva Tarea
                </a>
            </div>

            <div class="box-body p-0">
                <div class="table-responsive">
                    @Html.AntiForgeryToken()
                    <table class="table table-hover mb-0" id="tareas-table">
                        <thead class="bg-light">
                            <tr>
                                <th>Responsable</th>
                                <th>Descripción de la Tarea</th>
                                <th>Relacionado con</th>
                                <th>Vencimiento</th>
                                <th>Prioridad</th>
                                <th>Estado</th>
                                <th>Descripción de Finalización</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted p-20">
                                        No se encontraron tareas registradas.
                                    </td>
                                </tr>
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">
                                        @(item.usuario != null ? item.usuario.nombre + " " + item.usuario.apellido : "Sin asignar")
                                    </td>
                                    <td>
                                        <span class="text-dark fw-500">
                                            @item.titulo
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.descripcion))
                                        {
                                            <br /><small class="text-fade">@item.descripcion</small>
                                        }
                                    </td>
                                    <td>
                                        @if (item.cliente != null)
                                        {
                                            <span class="fw-bold">@item.cliente.empresa</span>
                                            <br /><small class="text-dark"><i class="fa fa-user-circle-o me-1"></i> Principal: @item.cliente.nombre</small>
                                        }
                                        else
                                        {
                                            <span>Sin cliente</span>
                                        }

                                        @if (!string.IsNullOrEmpty(item.contacto_nombre))
                                        {
                                            <br /><small class="text-fade"><i class="fa fa-user me-1"></i> Secundario: @item.contacto_nombre</small>
                                        }
                                    </td>
                                    <td>
                                        @(item.fecha_limite.HasValue
                                            ? item.fecha_limite.Value.ToString("dd/MM/yyyy")
                                            : "Sin fecha")
                                    </td>
                                    <td>
                                        @if (item.prioridad == "Alta")
                                        {
                                            <span class="badge badge-danger">Alta</span>
                                        }
                                        else if (item.prioridad == "Media")
                                        {
                                            <span class="badge badge-warning text-dark">Media</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-info">Baja</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.estado == "Completada")
                                        {
                                            <span class="badge badge-success-light">@item.estado</span>
                                        }
                                        else if (item.estado == "Aplazada")
                                        {
                                            <span class="badge badge-danger-light">@item.estado</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning-light">@item.estado</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.estado == "Completada" && !string.IsNullOrEmpty(item.descripcion_finalizacion))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary btn-ver-desc-finalizacion" data-desc="@item.descripcion_finalizacion" title="Ver descripción de finalización">
                                                <i class="fa fa-eye"></i> Ver Cierre
                                            </button>
                                        }
                                        else if (item.estado == "Aplazada" && !string.IsNullOrEmpty(item.descripcion) && item.descripcion.Contains("[Aplazada:"))
                                        {
                                            // Extraer la razón
                                            var startIndex = item.descripcion.IndexOf("[Aplazada:");
                                            var razonText = item.descripcion.Substring(startIndex).Replace("[Aplazada:", "").Replace("]", "").Trim();
                                            <button type="button" class="btn btn-sm btn-outline-warning btn-ver-desc-finalizacion" data-desc="Razón de aplazamiento: @razonText" title="Ver razón del aplazamiento">
                                                <i class="fa fa-clock-o"></i> Ver Razón
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @if (item.estado != "Completada")
                                        {
                                            <button class="btn btn-sm btn-success-light btn-completar-tarea" data-id="@item.id_tarea" title="Marcar como completada">
                                                <i class="fa fa-check"></i> Completada
                                            </button>
                                            <button class="btn btn-sm btn-warning-light btn-posponer-tarea" data-id="@item.id_tarea" title="Aplazar / Posponer">
                                                <i class="fa fa-clock-o"></i> Aplazar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Posponer Tarea -->
<div class="modal fade" id="modal-posponer-tarea" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Aplazar Tarea Comercial</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group mb-3">
                    <label class="form-label">Nueva Fecha Límite</label>
                    <input type="date" id="posponer-fecha" class="form-control" required />
                </div>
                <div class="form-group mb-3">
                    <label class="form-label">Razón del Aplazamiento / Justificación</label>
                    <textarea id="posponer-razon" rows="3" class="form-control" placeholder="Escriba aquí la justificación de por qué se posterga la actividad comercial..." required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-warning" id="btn-confirmar-posponer">Confirmar Aplazamiento</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Content/assets/vendor_components/apexcharts-bundle/dist/apexcharts.js")"></script>
    <script>
        $(document).ready(function() {
            // Completar Tarea AJAX
$('.btn-completar-tarea').on('click', function() {
    var taskId = $(this).data('id');
    var token = $('input[name="__RequestVerificationToken"]').val();

    Swal.fire({
        title: '¿Completar tarea?',
        text: 'Ingrese la descripción de cómo se finalizó esta tarea:',
        icon: 'question',
        input: 'textarea',
        inputPlaceholder: 'Describa el resultado o detalle de la finalización...',
        showCancelButton: true,
        confirmButtonColor: '#10c469',
        cancelButtonColor: '#9e9e9e',
        confirmButtonText: 'Sí, completar',
        cancelButtonText: 'Cancelar',
        inputValidator: (value) => {
            if (!value || !value.trim()) {
                return 'Debe ingresar una descripción para completar la tarea.';
            }
        }
    }).then((result) => {
        if (result.isConfirmed) {
            $.ajax({
                url: '@Url.Action("Completar", "Tareas")',
                type: 'POST',
                data: {
                    id: taskId,
                    descripcionFinalizacion: result.value,
                    __RequestVerificationToken: token
                },
                success: function(res) {
                    if (res.success) {
                        Swal.fire('¡Completada!', res.message, 'success').then(function() {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('Error', 'Error de red al completar la tarea.', 'error');
                }
            });
        }
    });
});

            // Ver descripción de finalización
            $(document).on('click', '.btn-ver-desc-finalizacion', function () {
                var desc = $(this).data('desc');
                Swal.fire({
                    title: 'Descripción de Finalización',
                    text: desc,
                    icon: 'info',
                    confirmButtonText: 'Cerrar'
                });
            });

            // Posponer Tarea AJAX
            var currentPosponerId = null;
            $('.btn-posponer-tarea').on('click', function() {
                currentPosponerId = $(this).data('id');
                $('#modal-posponer-tarea').modal('show');
            });

            $('#btn-confirmar-posponer').on('click', function() {
                var razon = $('#posponer-razon').val();
                var nuevaFecha = $('#posponer-fecha').val();
                var token = $('input[name="__RequestVerificationToken"]').val();

                if (!nuevaFecha || !razon) {
                    Swal.fire('Campos requeridos', 'Debe especificar la nueva fecha y la razón del aplazamiento.', 'warning');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("Posponer", "Tareas")',
                    type: 'POST',
                    data: {
                        id: currentPosponerId,
                        razon: razon,
                        nuevaFecha: nuevaFecha,
                        __RequestVerificationToken: token
                    },
                    success: function(res) {
                        if (res.success) {
                            $('#modal-posponer-tarea').modal('hide');
                            Swal.fire('¡Aplazada!', res.message, 'success').then(function() {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Error', 'Error al postergar la tarea.', 'error');
                    }
                });
            });

            // Obtener paleta de colores para gráficos desde localStorage (HU-038)
            var chartPalette = localStorage.getItem('crm_chart_palette') || 'classic';
            var palettes = {
                classic: {
                    line: ['#1d3557'],
                    donut: ['#2a9d8f', '#f4a261', '#e63946', '#1d3557', '#a8dadc', '#457b9d', '#e76f51', '#264653', '#e9c46a', '#f4a261', '#e76f51', '#9b5de5', '#f15bb5', '#00f5d4', '#00bbf9', '#fee440', '#3a86c8', '#8338ec', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#00f5d4', '#00bbf9', '#ff006e', '#f15bb5', '#9b5de5', '#2a9d8f', '#e63946'],
                    bar: ['#1d3557', '#e63946', '#457b9d', '#a8dadc', '#f4a261', '#e76f51', '#264653', '#e9c46a', '#f4a261', '#e76f51', '#9b5de5', '#f15bb5', '#00f5d4', '#00bbf9', '#fee440', '#3a86c8', '#8338ec', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#00f5d4', '#00bbf9', '#ff006e', '#f15bb5', '#9b5de5', '#2a9d8f', '#e63946']
                },
                ocean: {
                    line: ['#0077b6'],
                    donut: ['#0096c7', '#00b4d8', '#48cae4', '#90e0ef', '#03045e', '#023e8a', '#0077b6', '#0096c7', '#00b4d8', '#90e0ef', '#48cae4', '#00f5d4', '#00bbf9', '#3a86c8', '#8338ec', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200'],
                    bar: ['#03045e', '#023e8a', '#0077b6', '#0096c7', '#00b4d8', '#90e0ef', '#48cae4', '#00f5d4', '#00bbf9', '#3a86c8', '#8338ec', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#00f5d4', '#00bbf9', '#ff006e', '#f15bb5', '#9b5de5', '#2a9d8f', '#e63946']
                },
                neon: {
                    line: ['#7209b7'],
                    donut: ['#f72585', '#7209b7', '#3f37c9', '#4cc9f0', '#b5179e', '#480ca8', '#3a0ca3', '#3f37c9', '#4361ee', '#4cc9f0', '#7209b7', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200'],
                    bar: ['#f72585', '#b5179e', '#7209b7', '#480ca8', '#3f37c9', '#4361ee', '#4cc9f0', '#7209b7', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#00f5d4', '#00bbf9', '#ff006e', '#f15bb5', '#9b5de5', '#2a9d8f', '#e63946']
                },
                sunset: {
                    line: ['#d90429'],
                    donut: ['#d90429', '#f77f00', '#fcbf49', '#eae2b7', '#ef233c', '#ffb703', '#fb8500', '#d90429', '#ef233c', '#f77f00', '#fcbf49', '#eae2b7', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200'],
                    bar: ['#d90429', '#ef233c', '#f77f00', '#fcbf49', '#eae2b7', '#ffb703', '#fb8500', '#d90429', '#ef233c', '#f77f00', '#fcbf49', '#eae2b7', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#00f5d4', '#00bbf9', '#ff006e', '#f15bb5', '#9b5de5', '#2a9d8f', '#e63946']
                },
                forest: {
                    line: ['#2c6e49'],
                    donut: ['#2c6e49', '#4c956c', '#a3b18a', '#588157', '#1b4332', '#2d6a4f', '#40916c', '#52b788', '#74c69d', '#2c6e49', '#4c956c', '#a3b18a', '#588157', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200'],
                    bar: ['#1b4332', '#2d6a4f', '#40916c', '#52b788', '#74c69d', '#2c6e49', '#4c956c', '#a3b18a', '#588157', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#00f5d4', '#00bbf9', '#ff006e', '#f15bb5', '#9b5de5', '#2a9d8f', '#e63946']
                }
            };
            var selectedColors = palettes[chartPalette] || palettes.classic;
            if (chartPalette === 'custom') {
                var customColorsStr = localStorage.getItem('crm_custom_chart_colors');
                var customColors = ['#2a9d8f', '#f4a261', '#e63946', '#1d3557', '#a8dadc', '#9b5de5', '#f15bb5', '#00f5d4', '#00bbf9', '#fee440'];
                if (customColorsStr) {
                    try { customColors = JSON.parse(customColorsStr); } catch(e) {}
                }
                if (customColors.length < 20) {
                    customColors = customColors.concat(['#3a86c8', '#8338ec', '#ff006e', '#ffbe0b', '#fb5607', '#38b000', '#007200', '#2a9d8f', '#f4a261', '#e63946']);
                }
                selectedColors = {
                    line: [customColors[0]],
                    donut: customColors,
                    bar: customColors
                };
            }

            var boxBgColor = localStorage.getItem('crm_box_bg_color') || '#ffffff';
            var r = parseInt(boxBgColor.substr(1, 2), 16);
            var g = parseInt(boxBgColor.substr(3, 2), 16);
            var b = parseInt(boxBgColor.substr(5, 2), 16);
            var yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
            var chartThemeMode = (yiq < 128) ? 'dark' : 'light';
            var chartLabelColor = (yiq < 128) ? '#ffffff' : '#5a6a85';

            // Tareas por Usuario (Pie Chart)
            if($('#user-task-chart').length > 0) {
                var userLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(userLabels));
                var userValues = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(userValues));

                if (userLabels.length === 0) {
                     userLabels = ['Sin datos'];
                     userValues = [0];
                }

                var optionsUser = {
                    series: userValues,
                    chart: { type: 'pie', height: 320, background: 'transparent', redrawOnWindowResize: true },
                    theme: { mode: chartThemeMode },
                    labels: userLabels,
                    colors: selectedColors.bar,
                    stroke: { colors: [boxBgColor], width: 1 },
                    dataLabels: {
                        enabled: false
                    },
                    legend: {
                        position: 'bottom',
                        horizontalAlign: 'center',
                        floating: false,
                        labels: { colors: chartLabelColor },
                        itemMargin: { horizontal: 5, vertical: 5 },
                        formatter: function(seriesName, opts) {
                            var total = opts.w.globals.series.reduce(function(acc, val) { return acc + val; }, 0);
                            var val = opts.w.globals.series[opts.seriesIndex];
                            var pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                            return seriesName + " - " + val + " (" + pct + "%)";
                        }
                    },
                    responsive: [{
                        breakpoint: 480,
                        options: {
                            chart: { height: 300 },
                            legend: { position: 'bottom' }
                        }
                    }]
                };
                new ApexCharts(document.querySelector("#user-task-chart"), optionsUser).render();
            }

            // Tareas por Categoría/Estado (Donut Chart)
            if($('#category-task-chart').length > 0) {
                var catLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(categoryLabels));
                var catValues = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(categoryValues));

                if (catLabels.length === 0) {
                    catLabels = ['Sin datos'];
                    catValues = [0];
                }

                var optionsCategory = {
                    series: catValues,
                    chart: { type: 'donut', height: 320, background: 'transparent', redrawOnWindowResize: true },
                    theme: { mode: chartThemeMode },
                    labels: catLabels,
                    colors: selectedColors.donut,
                    stroke: { colors: [boxBgColor], width: 1 },
                    dataLabels: {
                        enabled: false
                    },
                    legend: {
                        position: 'bottom',
                        horizontalAlign: 'center',
                        floating: false,
                        labels: { colors: chartLabelColor },
                        itemMargin: { horizontal: 5, vertical: 5 },
                        formatter: function(seriesName, opts) {
                            var total = opts.w.globals.series.reduce(function(acc, val) { return acc + val; }, 0);
                            var val = opts.w.globals.series[opts.seriesIndex];
                            var pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                            return seriesName + " - " + val + " (" + pct + "%)";
                        }
                    },
                    responsive: [{
                        breakpoint: 480,
                        options: {
                            chart: { height: 300 },
                            legend: { position: 'bottom' }
                        }
                    }]
                };
                new ApexCharts(document.querySelector("#category-task-chart"), optionsCategory).render();
            }

            // Tareas por Prioridad (Bar Chart)
            if($('#priority-task-chart').length > 0) {
                var prioLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(priorityLabels));
                var prioValues = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(priorityValues));

                if (prioLabels.length === 0) {
                    prioLabels = ['Alta', 'Media', 'Baja'];
                    prioValues = [0, 0, 0];
                }

                var optionsPriority = {
                    series: [{ name: 'Tareas', data: prioValues }],
                    chart: { type: 'bar', height: 320, toolbar: { show: false }, background: 'transparent', redrawOnWindowResize: true },
                    theme: { mode: chartThemeMode },
                    plotOptions: { bar: { columnWidth: '45%', borderRadius: 4, distributed: true } },
                    xaxis: {
                        categories: prioLabels,
                        labels: {
                            rotate: -45,
                            rotateAlways: true,
                            style: {
                                colors: chartLabelColor,
                                fontSize: '11px',
                                fontWeight: 600
                            }
                        }
                    },
                    yaxis: {
                        labels: {
                            style: {
                                colors: chartLabelColor
                            }
                        }
                    },
                    colors: selectedColors.bar,
                    legend: {
                        position: 'bottom',
                        horizontalAlign: 'center',
                        labels: { colors: chartLabelColor },
                        itemMargin: { horizontal: 5, vertical: 5 }
                    },
                    dataLabels: { enabled: false }
                };
                new ApexCharts(document.querySelector("#priority-task-chart"), optionsPriority).render();
            }

            // Inicializar paginación de tareas
            paginarTabla('tareas-table', 5);

            // Adaptar buscador del header para Tareas
            var $globalSearch = $('#buscador-global-header');
            if ($globalSearch.length > 0) {
                $('#form-buscador-global').on('submit', function(e) {
                    e.preventDefault();
                });
                $globalSearch.attr('placeholder', 'Buscar tareas (descripción, relacionado, prioridad)...');
                
                $globalSearch.on('keyup input', function() {
                    var query = $(this).val().toLowerCase().trim();
                    
                    $('#tareas-table tbody tr').each(function() {
                        var $row = $(this);
                        if ($row.find('td').length === 1 && $row.find('td').attr('colspan')) return; // Saltar fila de sin datos
                        
                        var responsable = $row.find('td:nth-child(1)').text().toLowerCase();
                        var descripcion = $row.find('td:nth-child(2)').text().toLowerCase();
                        var relacionado = $row.find('td:nth-child(3)').text().toLowerCase();
                        var prioridad = $row.find('td:nth-child(5)').text().toLowerCase();
                        var estado = $row.find('td:nth-child(6)').text().toLowerCase();
                        
                        if (responsable.indexOf(query) > -1 || descripcion.indexOf(query) > -1 || relacionado.indexOf(query) > -1 || prioridad.indexOf(query) > -1 || estado.indexOf(query) > -1) {
                            $row.removeClass('filtrado-oculto');
                        } else {
                            $row.addClass('filtrado-oculto');
                        }
                    });
                    
                    paginarTabla('tareas-table', 5);
                });
            }
        });

        function paginarTabla(tableId, recordsPerPage) {
            const $table = $('#' + tableId);
            if ($table.length === 0) return;

            $('#' + tableId + '-pagination').remove();

            const $tbody = $table.find('tbody');
            const $rows = $tbody.find('tr').filter(function() {
                return !$(this).hasClass('filtrado-oculto');
            });

            const totalRows = $rows.length;
            if (totalRows === 0) {
                $tbody.find('tr').hide();
                return;
            }
            if (totalRows <= recordsPerPage) {
                $tbody.find('tr').hide();
                $rows.show();
                return;
            }

            let currentPage = 1;
            const totalPages = Math.ceil(totalRows / recordsPerPage);

            const $navContainer = $('<div class="d-flex justify-content-between align-items-center mt-3 px-3 pb-3 flex-wrap gap-2" id="' + tableId + '-pagination"></div>');
            const $infoText = $('<span class="text-muted small"></span>');
            const $paginationUl = $('<ul class="pagination pagination-sm mb-0"></ul>');

            $navContainer.append($infoText).append($paginationUl);
            $table.after($navContainer);

            function showPage(page) {
                currentPage = page;
                const start = (page - 1) * recordsPerPage;
                const end = start + recordsPerPage;

                $tbody.find('tr').hide();
                $rows.slice(start, end).show();

                const shownCount = Math.min(end, totalRows);
                $infoText.text('Mostrando del ' + (start + 1) + ' al ' + shownCount + ' de ' + totalRows + ' registros.');

                $paginationUl.empty();
                const $prevLi = $('<li class="page-item"><a class="page-link" href="javascript:void(0)">&laquo;</a></li>');
                if (currentPage === 1) $prevLi.addClass('disabled');
                else $prevLi.on('click', () => showPage(currentPage - 1));
                $paginationUl.append($prevLi);

                for (let i = 1; i <= totalPages; i++) {
                    const $pageLi = $('<li class="page-item"><a class="page-link" href="javascript:void(0)">' + i + '</a></li>');
                    if (i === currentPage) $pageLi.addClass('active');
                    else $pageLi.on('click', () => showPage(i));
                    $paginationUl.append($pageLi);
                }

                const $nextLi = $('<li class="page-item"><a class="page-link" href="javascript:void(0)">&raquo;</a></li>');
                if (currentPage === totalPages) $nextLi.addClass('disabled');
                else $nextLi.on('click', () => showPage(currentPage + 1));
                $paginationUl.append($nextLi);
            }

            showPage(1);
        }
    </script>
}
