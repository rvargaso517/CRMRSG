@model CRMRSG.Models.ImportacionClientesViewModel

@{
    ViewBag.Title = "Importar Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="d-flex align-items-center">
        <div class="me-auto">
            <h4 class="page-title">Importación Masiva de Clientes</h4>

            <div class="d-inline-block align-items-center">
                <nav>
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="~/Dashboard">
                                <i class="mdi mdi-home-outline"></i>
                            </a>
                        </li>

                        <li class="breadcrumb-item">
                            <a href="~/Clientes">Clientes</a>
                        </li>

                        <li class="breadcrumb-item active"
                            aria-current="page">
                            Importar
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 col-12">
        <div class="box">

            <div class="box-header with-border">
                <h4 class="box-title">
                    Seleccionar archivo
                </h4>
            </div>

            @using (Html.BeginForm(
                "Index",
                "ImportacionClientes",
                FormMethod.Post,
                new
                {
                    enctype = "multipart/form-data",
                    @class = "form"
                }))
            {
                @Html.AntiForgeryToken()

                <div class="box-body">

                    <h4 class="box-title text-info mb-0">
                        <i class="ti-upload me-15"></i>
                        Archivo CSV o Excel
                    </h4>

                    <hr class="my-15" />

                    <div class="alert alert-info">
                        <strong>Columnas obligatorias:</strong>
                        nombre, empresa y correo.
                        <br />

                        <strong>Columnas opcionales:</strong>
                        telefono, direccion y estado.
                    </div>

                    @Html.ValidationSummary(
                        false,
                        "",
                        new { @class = "text-danger mb-3" }
                    )

                    <div class="form-group">
                        <label class="form-label">
                            Archivo para importar
                        </label>

                        <input type="file"
                               name="Archivo"
                               id="Archivo"
                               class="form-control"
                               accept=".csv,.xlsx,.xls"
                               required />

                        <small class="text-muted">
                            Formatos permitidos: CSV, XLSX y XLS.
                        </small>
                    </div>

                </div>

                <div class="box-footer">
                    <a href="@Url.Action("Index", "Clientes")"
                       class="btn btn-warning me-1">
                        <i class="ti-arrow-left"></i>
                        Volver
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="ti-upload"></i>
                        Procesar archivo
                    </button>
                </div>
            }

        </div>
    </div>
</div>

@if (Model != null && Model.ProcesoFinalizado)
{
    <div class="row">
        <div class="col-12">
            <div class="box">

                <div class="box-header with-border">
                    <h4 class="box-title">
                        Resumen de la importación
                    </h4>
                </div>

                <div class="box-body">

                    <div class="row">

                        <div class="col-xl-3 col-md-6 col-12">
                            <div class="box">
                                <div class="box-body text-center">
                                    <h5 class="text-muted">
                                        Procesados
                                    </h5>

                                    <h2 class="fs-30 mb-1 mt-0">
                                        @Model.TotalProcesados
                                    </h2>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6 col-12">
                            <div class="box">
                                <div class="box-body text-center">
                                    <h5 class="text-muted">
                                        Creados
                                    </h5>

                                    <h2 class="fs-30 mb-1 mt-0 text-success">
                                        @Model.TotalCreados
                                    </h2>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6 col-12">
                            <div class="box">
                                <div class="box-body text-center">
                                    <h5 class="text-muted">
                                        Actualizados
                                    </h5>

                                    <h2 class="fs-30 mb-1 mt-0 text-info">
                                        @Model.TotalActualizados
                                    </h2>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6 col-12">
                            <div class="box">
                                <div class="box-body text-center">
                                    <h5 class="text-muted">
                                        Errores
                                    </h5>

                                    <h2 class="fs-30 mb-1 mt-0 text-danger">
                                        @Model.TotalErrores
                                    </h2>
                                </div>
                            </div>
                        </div>

                    </div>

                    @if (Model.Errores != null &&
                         Model.Errores.Any())
                    {
                        <div class="alert alert-danger mt-3">
                            <h5>
                                <i class="fa fa-exclamation-triangle"></i>
                                Registros no procesados
                            </h5>

                            <ul class="mb-0">
                                @foreach (string error in Model.Errores)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success mt-3">
                            <i class="fa fa-check-circle"></i>
                            El archivo se procesó correctamente.
                        </div>
                    }

                    <a href="@Url.Action("Index", "Clientes")"
                       class="btn btn-success">
                        <i class="fa fa-users"></i>
                        Ver clientes
                    </a>

                </div>

            </div>
        </div>
    </div>
}